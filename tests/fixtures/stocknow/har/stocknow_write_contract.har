9a\u09bf\u09a4\u09cd\u09b0\",\"Top Sectors By Gainer\":\"\u09a6\u09be\u09ae \u09ac\u09c3\u09a6\u09cd\u09a7\u09bf\u09a4\u09c7 \u09b6\u09c0\u09b0\u09cd\u09b7 \u0996\u09be\u09a4\",\"Top Sectors By Value/Category\":\"\u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u09c7\u09b0 \u09ae\u09c2\u09b2\u09cd\u09af/\u0995\u09cd\u09af\u09be\u099f\u09be\u0997\u09b0\u09bf\u09a4\u09c7 \u09b6\u09c0\u09b0\u09cd\u09b7 \u0996\u09be\u09a4\",\"Top Shares\":\"\u09b6\u09c0\u09b0\u09cd\u09b7 \u09b6\u09c7\u09af\u09bc\u09be\u09b0\",\"Total Buy:\":\"\u09ae\u09cb\u099f \u0995\u09cd\u09b0\u09af\u09bc:\",\"Total Buyer (Qty):\":\"\u09ae\u09cb\u099f \u0995\u09cd\u09b0\u09c7\u09a4\u09be (\u09aa\u09b0\u09bf\u09ae\u09be\u09a3):\",\"Total Sell:\":\"\u09ae\u09cb\u099f \u09ac\u09bf\u0995\u09cd\u09b0\u09af\u09bc:\",\"Total Seller (Qty):\":\"\u09ae\u09cb\u099f \u09ac\u09bf\u0995\u09cd\u09b0\u09c7\u09a4\u09be (\u09aa\u09b0\u09bf\u09ae\u09be\u09a3):\",\"Total Shares\":\"\u09ae\u09cb\u099f \u09b6\u09c7\u09af\u09bc\u09be\u09b0\",\"Total payable\":\"\u09ae\u09cb\u099f \u09aa\u09b0\u09bf\u09b6\u09cb\u09a7\u09af\u09cb\u0997\u09cd\u09af\",\"Total shares: {count}\":\"\u09ae\u09cb\u099f \u09b6\u09c7\u09af\u09bc\u09be\u09b0: {count}\",\"Track your holdings\":\"\u0986\u09aa\u09a8\u09be\u09b0 \u09b6\u09c7\u09af\u09bc\u09be\u09b0\u09c7\u09b0 \u09b9\u09bf\u09b8\u09be\u09ac \u09b0\u09be\u0996\u09c1\u09a8\",\"Trade\":\"\u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\",\"Trade Info\":\"\u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u09c7\u09b0 \u09a4\u09a5\u09cd\u09af\",\"Traded\":\"\u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 \u09b9\u09af\u09bc\u09c7\u099b\u09c7\",\"Trades\":\"\u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\",\"Trades, Vol:\":\"\u09b2\u09c7\u09a8\u09a6\u09c7\u09a8, \u09ad\u09b2\u09bf\u0989\u09ae:\",\"Trading session\":\"\u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u09c7\u09b0 \u09b8\u09c7\u09b6\u09a8\",\"Trailing Twelve Months\":\"\u0997\u09a4 \u09ac\u09be\u09b0\u09cb \u09ae\u09be\u09b8\",\"Transition phase\":\"\u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8\u09c7