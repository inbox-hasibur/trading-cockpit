hip Update \u0995\u09b0\u09c1\u09a8\u0964\":\"\u0986\u09aa\u09a8\u09be\u09b0 VIP \u09ae\u09c7\u09af\u09bc\u09be\u09a6 \u09b6\u09c7\u09b7\u09c7\u09b0 \u09aa\u09a5\u09c7\u0964 \u0997\u09c1\u09b0\u09c1\u09a4\u09cd\u09ac\u09aa\u09c2\u09b0\u09cd\u09a3 Analysis Tools \u099a\u09be\u09b2\u09c1 \u09b0\u09be\u0996\u09a4\u09c7 Membership Update \u0995\u09b0\u09c1\u09a8\u0964\",\"Renew before your access ends in {expireDays} days\":\"{expireDays} \u09a6\u09bf\u09a8\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u09ae\u09c7\u09af\u09bc\u09be\u09a6 \u09b6\u09c7\u09b7 \u09b9\u0993\u09af\u09bc\u09be\u09b0 \u0986\u0997\u09c7 \u09a8\u09ac\u09be\u09af\u09bc\u09a8 \u0995\u09b0\u09c1\u09a8\",\"Renew to restore premium alarms, screeners, reports, and your ad-free workflow.\":\"\u09aa\u09cd\u09b0\u09bf\u09ae\u09bf\u09af\u09bc\u09be\u09ae \u0985\u09cd\u09af\u09be\u09b2\u09be\u09b0\u09cd\u09ae, \u09b8\u09cd\u0995\u09cd\u09b0\u09bf\u09a8\u09be\u09b0, \u09b0\u09bf\u09aa\u09cb\u09b0\u09cd\u099f \u098f\u09ac\u0982 \u09ac\u09bf\u099c\u09cd\u099e\u09be\u09aa\u09a8\u09ac\u09bf\u09b9\u09c0\u09a8 \u09b8\u09c1\u09ac\u09bf\u09a7\u09be \u09ab\u09bf\u09b0\u09c7 \u09aa\u09c7\u09a4\u09c7 \u09a8\u09ac\u09be\u09af\u09bc\u09a8 \u0995\u09b0\u09c1\u09a8\u0964\",\"Renewed\":\"\u09a8\u09ac\u09be\u09af\u09bc\u09a8 \u09b9\u09af\u09bc\u09c7\u099b\u09c7\",\"Reorder\":\"\u0995\u09cd\u09b0\u09ae \u09ac\u09a6\u09b2\u09be\u09a8\",\"Report generated\":\"\u09aa\u09cd\u09b0\u09a4\u09bf\u09ac\u09c7\u09a6\u09a8 \u09a4\u09c8\u09b0\u09bf\u09b0 \u09b8\u09ae\u09af\u09bc\",\"Reporting period\":\"\u09b9\u09bf\u09b8\u09be\u09ac\u0995\u09be\u09b2\",\"Reserve & Surp\":\"\u09b0\u09bf\u099c\u09be\u09b0\u09cd\u09ad \u0993 \u0989\u09a6\u09cd\u09ac\u09c3\u09a4\u09cd\u09a4\",\"Reserve & Surplus\":\"\u09b0\u09bf\u099c\u09be\u09b0\u09cd\u09ad \u0993 \u0989\u09a6\u09cd\u09ac\u09c3\u09a4\u09cd\u09a4\",\"Reset\":\"\u09b0\u09bf\u09b8\u09c7\u099f\",\"Resistance broken upward\":\"\u09b0\u09c7\u099c\u09bf\u09b8\u09cd\u099f\u09cd\u09af\u09be\u09a8\u09cd\u09b8 \u09ad\u09c7\u0999\u09c7 \u0989\u09aa\u09b0\u09c7 \u0989\u09a0\u09c7\u099b\u09c7\",\"Resistance zones\":\"\u09b0\u09c7\u099c\u09bf\u09b8\u09cd\u099f\u09cd\u09af\u09be\u09a8\u09cd\u09b8 \u099c\u09cb\u09a8\",\"Resolution\":\"\u09b8\u09ae\u09af\u09bc\u09b8\u09c0\u09ae\u09be\",\"Restart\":\"\u09aa\u09c1\u09a8\u09b0\u09be\u09af\u09bc \u099a\u09be\u09b2\u09c1 \u0995\u09b0\u09c1\u09a8\",\"Restore Purchases\":\"\u0995\u09c7\u09a8\u09be\u0995\u09be\u099f\u09be \u09aa\u09c1\u09a8\u09b0\u09c1\u09a6\u09cd\u09a7\u09be\u09b0 \u0995\u09b0\u09c1\u09a8\",\"Result filters\":\"\u09ab\u09b2\u09be\u09ab\u09b2\u09c7\u09b0 \u09ab\u09bf\u09b2\u09cd\u099f\u09be\u09b0\",\"Result view\":\"\u09ab\u09b2\u09be\u09ab\u09b2 \u09a6\u09c7\u0996\u09be\u09a8\u09cb\u09b0 \u09a7\u09b0\u09a8\",\"Results\":\"\u09ab\u09b2\u09be\u09ab\u09b2\",\"Retest\":\"\u09b0\u09bf\u099f\u09c7\u09b8\u09cd\u099f\",\"Retest expired\":\"\u09b0\u09bf\u099f\u09c7\u09b8\u09cd\u099f\u09c7\u09b0 \u09ae\u09c7\u09af\u09bc\u09be\u09a6 \u09b6\u09c7\u09b7\",\"Retest failed\":\"\u09b0\u09bf\u099f\u09c7\u09b8\u09cd\u099f \u09ac\u09cd\u09af\u09b0\u09cd\u09a5 \u09b9\u09af\u09bc\u09c7\u099b\u09c7\",\"Retest held; current setup unverified\":\"\u09b0\u09bf\u099f\u09c7\u09b8\u09cd\u099f\u09c7 \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u09a7\u09b0\u09c7 \u09b0\u09c7\u0996\u09c7\u099b\u09bf\u09b2; \u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8 \u09b8\u09c7\u099f\u0986\u09aa \u09af\u09be\u099a\u09be\u0987\u0995\u09c3\u09a4 \u09a8\u09af\u09bc\",\"Retest held; direction unavailable\":\"\u09b0\u09bf\u099f\u09c7\u09b8\u09cd\u099f\u09c7 \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u09a7\u09b0\u09c7 \u09b0\u09c7\u0996\u09c7\u099b\u09c7; \u09a6\u09bf\u0995\u09c7\u09b0 \u09a4\u09a5\u09cd\u09af \u09a8\u09c7\u0987\",\"Retest in progress\":\"\u09b0\u09bf\u099f\u09c7\u09b8\u09cd\u099f \u099a\u09b2\u099b\u09c7\",\"Retry\":\"\u0986\u09ac\u09be\u09b0 \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09c1\u09a8\",\"Return Refund Policy\":\"\u09ab\u09c7\u09b0\u09a4 \u0993 \u09b0\u09bf\u09ab\u09be\u09a8\u09cd\u09a1 \u09a8\u09c0\u09a4\u09bf\",\"Return over 20 sessions\":\"\u09e8\u09e6 \u09b8\u09c7\u09b6\u09a8\u09c7\u09b0 \u09b0\u09bf\u099f\u09be\u09b0\u09cd\u09a8\",\"Return over 5 sessions\":\"\u09eb \u09b8\u09c7\u09b6\u09a8\u09c7\u09b0 \u09b0\u09bf\u099f\u09be\u09b0\u09cd\u09a8\",\"Return over 60 sessions\":\"\u09ec\u09e6 \u09b8\u09c7\u09b6\u09a8\u09c7\u09b0 \u09b0\u09bf\u099f\u09be\u09b0\u09cd\u09a8\",\"Reversal\":\"\u09ac\u09bf\u09aa\u09b0\u09c0\u09a4\u09ae\u09c1\u0996\u09c0 \u09aa\u09cd\u09b0\u09ac\u09a3\u09a4\u09be\",\"Review stock analysis\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0\u09c7\u09b0 \u09ac\u09bf\u09b6\u09cd\u09b2\u09c7\u09b7\u09a3 \u09a6\u09c7\u0996\u09c1\u09a8\",\"Review your watchlist leader\":\"\u09a8\u099c\u09b0\u09a6\u09be\u09b0\u09bf \u09a4\u09be\u09b2\u09bf\u0995\u09be\u09b0 \u09b6\u09c0\u09b0\u09cd\u09b7 \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09a6\u09c7\u0996\u09c1\u09a8\",\"Review {code}\":\"{code} \u09a6\u09c7\u0996\u09c1\u09a8\",\"Reward ads are unavailable right now. Please try again later.\":\"Reward ad \u098f\u0996\u09a8 \u09aa\u09be\u0993\u09df\u09be \u09af\u09be\u099a\u09cd\u099b\u09c7 \u09a8\u09be\u0964 \u0995\u09bf\u099b\u09c1\u0995\u09cd\u09b7\u09a3 \u09aa\u09b0 \u0986\u09ac\u09be\u09b0 \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09c1\u09a8\u0964\",\"Rising phase\":\"\u0989\u09a4\u09cd\u09a5\u09be\u09a8\u09c7\u09b0 \u09aa\u09b0\u09cd\u09af\u09be\u09af\u09bc\",\"Risks to consider\":\"\u09ac\u09bf\u09ac\u09c7\u099a\u09cd\u09af \u099d\u09c1\u0981\u0995\u09bf\",\"Run\":\"\u099a\u09be\u09b2\u09be\u09a8\",\"Run now\":\"\u098f\u0996\u09a8\u0987 \u099a\u09be\u09b2\u09be\u09a8\",\"Run one focused screener\":\"\u09a8\u09bf\u09b0\u09cd\u09a6\u09bf\u09b7\u09cd\u099f \u09b6\u09b0\u09cd\u09a4\u09c7\u09b0 \u098f\u0995\u099f\u09bf \u09b8\u09cd\u0995\u09cd\u09b0\u09bf\u09a8\u09be\u09b0 \u099a\u09be\u09b2\u09be\u09a8\",\"Run screeners before checking random stocks\":\"\u098f\u09b2\u09cb\u09ae\u09c7\u09b2\u09cb \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09a6\u09c7\u0996\u09be\u09b0 \u0986\u0997\u09c7 \u09b8\u09cd\u0995\u09cd\u09b0\u09bf\u09a8\u09be\u09b0 \u099a\u09be\u09b2\u09be\u09a8\",\"SME Shares\":\"SME \u09b6\u09c7\u09af\u09bc\u09be\u09b0\",\"SN\":\"\u0995\u09cd\u09b0\u09ae\",\"Save\":\"\u09b8\u0982\u09b0\u0995\u09cd\u09b7\u09a3 \u0995\u09b0\u09c1\u09a8\",\"Save as new\":\"\u09a8\u09a4\u09c1\u09a8 \u09b9\u09bf\u09b8\u09c7\u09ac\u09c7 \u09b8\u0982\u09b0\u0995\u09cd\u09b7\u09a3 \u0995\u09b0\u09c1\u09a8\",\"Save new\":\"\u09a8\u09a4\u09c1\u09a8 \u09b8\u0982\u09b0\u0995\u09cd\u09b7\u09a3 \u0995\u09b0\u09c1\u09a8\",\"Scan again\":\"\u0986\u09ac\u09be\u09b0 \u09b8\u09cd\u0995\u09cd\u09af\u09be\u09a8 \u0995\u09b0\u09c1\u09a8\",\"Scanning market data\":\"\u09ac\u09be\u099c\u09be\u09b0\u09c7\u09b0 \u09a4\u09a5\u09cd\u09af \u09b8\u09cd\u0995\u09cd\u09af\u09be\u09a8 \u09b9\u099a\u09cd\u099b\u09c7\",\"Scanning...\":\"\u09b8\u09cd\u0995\u09cd\u09af\u09be\u09a8 \u09b9\u099a\u09cd\u099b\u09c7...\",\"Screener\":\"\u09b8\u09cd\u0995\u09cd\u09b0\u09bf\u09a8\u09be\u09b0\",\"Screener type color guide\":\"\u09b8\u09cd\u0995\u09cd\u09b0\u09bf\u09a8\u09be\u09b0\u09c7\u09b0 \u09a7\u09b0\u09a8 \u0985\u09a8\u09c1\u09af\u09be\u09af\u09bc\u09c0 \u09b0\u0999\u09c7\u09b0 \u09a8\u09bf\u09b0\u09cd\u09a6\u09c7\u09b6\u09bf\u0995\u09be\",\"Screener unlock\":\"\u09b8\u09cd\u0995\u09cd\u09b0\u09bf\u09a8\u09be\u09b0 \u0986\u09a8\u09b2\u0995\",\"Screeners\":\"\u09b8\u09cd\u0995\u09cd\u09b0\u09bf\u09a8\u09be\u09b0\u09b8\u09ae\u09c2\u09b9\",\"Search\":\"\u0985\u09a8\u09c1\u09b8\u09a8\u09cd\u09a7\u09be\u09a8\",\"Search Result\":\"\u0985\u09a8\u09c1\u09b8\u09a8\u09cd\u09a7\u09be\u09a8\u09c7\u09b0 \u09ab\u09b2\u09be\u09ab\u09b2\",\"Seasonality\":\"\u09ae\u09cc\u09b8\u09c1\u09ae\u09bf \u09aa\u09cd\u09b0\u09ac\u09a3\u09a4\u09be\",\"Seasonality watch\":\"\u09ae\u09cc\u09b8\u09c1\u09ae\u09bf \u09aa\u09cd\u09b0\u09ac\u09a3\u09a4\u09be \u09aa\u09b0\u09cd\u09af\u09ac\u09c7\u0995\u09cd\u09b7\u09a3\",\"Sector\":\"\u0996\u09be\u09a4\",\"Sector Shares\":\"\u0996\u09be\u09a4\u09c7\u09b0 \u09b6\u09c7\u09af\u09bc\u09be\u09b0\",\"Sectors\":\"\u0996\u09be\u09a4\u09b8\u09ae\u09c2\u09b9\",\"Secure Checkout\":\"\u09a8\u09bf\u09b0\u09be\u09aa\u09a6 \u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f\",\"Secure payment. VIP activates automatically after successful payment.\":\"\u09a8\u09bf\u09b0\u09be\u09aa\u09a6 \u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f\u0964 \u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f \u09b8\u09ab\u09b2 \u09b9\u09b2\u09c7 VIP \u09b8\u09cd\u09ac\u09af\u09bc\u0982\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09ad\u09be\u09ac\u09c7 \u099a\u09be\u09b2\u09c1 \u09b9\u09ac\u09c7\u0964\",\"See breadth and leaders\":\"\u09ac\u09be\u099c\u09be\u09b0\u09c7\u09b0 \u09ac\u09bf\u09b8\u09cd\u09a4\u09c3\u09a4\u09bf \u0993 \u09b6\u09c0\u09b0\u09cd\u09b7 \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09a6\u09c7\u0996\u09c1\u09a8\",\"Select Share\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09ac\u09c7\u099b\u09c7 \u09a8\u09bf\u09a8\",\"Select a stock to view stats.\":\"\u09aa\u09b0\u09bf\u09b8\u0982\u0996\u09cd\u09af\u09be\u09a8 \u09a6\u09c7\u0996\u09a4\u09c7 \u098f\u0995\u099f\u09bf \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09ac\u09c7\u099b\u09c7 \u09a8\u09bf\u09a8\u0964\",\"Select share and set target price\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09ac\u09c7\u099b\u09c7 \u09a8\u09bf\u09af\u09bc\u09c7 \u09b2\u0995\u09cd\u09b7\u09cd\u09af\u09a6\u09be\u09ae \u09a8\u09bf\u09b0\u09cd\u09a7\u09be\u09b0\u09a3 \u0995\u09b0\u09c1\u09a8\",\"Seller\":\"\u09ac\u09bf\u0995\u09cd\u09b0\u09c7\u09a4\u09be\",\"Send\":\"\u09aa\u09be\u09a0\u09be\u09a8\",\"Send Money to our Bkash personal number.\":\"\u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u0997\u09a4 \u09ac\u09bf\u0995\u09be\u09b6 \u09a8\u09ae\u09cd\u09ac\u09b0\u09c7 \u09b8\u09c7\u09a8\u09cd\u09a1 \u09ae\u09be\u09a8\u09bf \u0995\u09b0\u09c1\u09a8\u0964\",\"Send us your app feedback, suggestions, problems, or feature requests. Or call:\":\"\u0985\u09cd\u09af\u09be\u09aa \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09bf\u09a4 \u0986\u09aa\u09a8\u09be\u09b0 \u09ae\u09a4\u09be\u09ae\u09a4/\u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6, \u0995\u09cb\u09a8 \u09b8\u09ae\u09b8\u09cd\u09af\u09be \u09ac\u09be \u09a8\u09a4\u09c1\u09a8 \u0995\u09cb\u09a8 \u09ab\u09bf\u099a\u09be\u09b0 \u09af\u09cb\u0997 \u0995\u09b0\u09a4\u09c7 \u09ae\u09c7\u09b8\u09c7\u099c \u0995\u09b0\u09c1\u09a8 \u0964 \u0985\u09a5\u09ac\u09be \u09ab\u09cb\u09a8 \u0995\u09b0\u09c1\u09a8\u0983\",\"Sending\u2026\":\"\u09aa\u09be\u09a0\u09be\u09a8\u09cb \u09b9\u099a\u09cd\u099b\u09c7\u2026\",\"Sep\":\"\u09b8\u09c7\u09aa\u09cd\u099f\u09c7\",\"September\":\"\u09b8\u09c7\u09aa\u09cd\u099f\u09c7\u09ae\u09cd\u09ac\u09b0\",\"Server error or invalid request\":\"\u09b8\u09be\u09b0\u09cd\u09ad\u09be\u09b0\u09c7 \u09b8\u09ae\u09b8\u09cd\u09af\u09be \u09ac\u09be \u0985\u09a8\u09c1\u09b0\u09cb\u09a7\u099f\u09bf \u09b8\u09a0\u09bf\u0995 \u09a8\u09af\u09bc\",\"Set alarm\":\"\u0985\u09cd\u09af\u09be\u09b2\u09be\u09b0\u09cd\u09ae \u09a6\u09bf\u09a8\",\"Set new alarm\":\"\u09a8\u09a4\u09c1\u09a8 \u0985\u09cd\u09af\u09be\u09b2\u09be\u09b0\u09cd\u09ae \u09a6\u09bf\u09a8\",\"Share\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0\",\"Share Holding\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09a7\u09be\u09b0\u09a3\",\"Share Holding - {code}\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09a7\u09be\u09b0\u09a3 - {code}\",\"Share Holding - {date}\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09a7\u09be\u09b0\u09a3 - {date}\",\"Share Holding as on (\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09a7\u09be\u09b0\u09a3\u09c7\u09b0 \u09a4\u09be\u09b0\u09bf\u0996 (\",\"Share List by\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09a4\u09be\u09b2\u09bf\u0995\u09be\u09b0 \u09ad\u09bf\u09a4\u09cd\u09a4\u09bf\",\"Sharpen decisions\":\"\u09b8\u09bf\u09a6\u09cd\u09a7\u09be\u09a8\u09cd\u09a4 \u09a8\u09c7\u0993\u09af\u09bc\u09be\u09b0 \u09a6\u0995\u09cd\u09b7\u09a4\u09be \u09ac\u09be\u09a1\u09bc\u09be\u09a8\",\"Short Term Loan\":\"\u09b8\u09cd\u09ac\u09b2\u09cd\u09aa\u09ae\u09c7\u09af\u09bc\u09be\u09a6\u09bf \u098b\u09a3\",\"Short term loan\":\"\u09b8\u09cd\u09ac\u09b2\u09cd\u09aa\u09ae\u09c7\u09af\u09bc\u09be\u09a6\u09bf \u098b\u09a3\",\"Show details\":\"\u09ac\u09bf\u09b8\u09cd\u09a4\u09be\u09b0\u09bf\u09a4 \u09a6\u09c7\u0996\u09be\u09a8\",\"Show events in chart\":\"\u099a\u09be\u09b0\u09cd\u099f\u09c7 \u0987\u09ad\u09c7\u09a8\u09cd\u099f \u09a6\u09c7\u0996\u09be\u09a8\",\"Show stats\":\"\u09aa\u09b0\u09bf\u09b8\u0982\u0996\u09cd\u09af\u09be\u09a8 \u09a6\u09c7\u0996\u09be\u09a8\",\"Showing\":\"\u09a6\u09c7\u0996\u09be\u09a8\u09cb \u09b9\u099a\u09cd\u099b\u09c7\",\"Since the previous analysis\":\"\u0986\u0997\u09c7\u09b0 \u09ac\u09bf\u09b6\u09cd\u09b2\u09c7\u09b7\u09a3\u09c7\u09b0 \u09aa\u09b0 \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8\",\"Single\":\"\u098f\u0995\u0995\",\"Small\":\"\u099b\u09cb\u099f\",\"Snapshot updated\":\"\u09a4\u09a5\u09cd\u09af \u09b9\u09be\u09b2\u09a8\u09be\u0997\u09be\u09a6\u09c7\u09b0 \u09b8\u09ae\u09af\u09bc\",\"Sort\":\"\u09b8\u09be\u099c\u09be\u09a8\",\"Source date\":\"\u0989\u09ce\u09b8\u09c7\u09b0 \u09a4\u09be\u09b0\u09bf\u0996\",\"Sources ({count})\":\"\u09a4\u09a5\u09cd\u09af\u09c7\u09b0 \u0989\u09ce\u09b8 ({count})\",\"Spot Shares\":\"\u09b8\u09cd\u09aa\u099f \u09b6\u09c7\u09af\u09bc\u09be\u09b0\",\"Start\":\"\u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09c1\u09a8\",\"Start a conversation by asking about a stock...\":\"\u0995\u09cb\u09a8\u09cb \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7 \u099c\u09bf\u099c\u09cd\u099e\u09be\u09b8\u09be \u0995\u09b0\u09c7 \u0995\u09a5\u09cb\u09aa\u0995\u09a5\u09a8 \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09c1\u09a8...\",\"Start here\":\"\u098f\u0996\u09be\u09a8 \u09a5\u09c7\u0995\u09c7 \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09c1\u09a8\",\"Start learning about the stock market\":\"\u09b6\u09c7\u09df\u09be\u09b0 \u09ac\u09be\u099c\u09be\u09b0 \u09b6\u09c7\u0996\u