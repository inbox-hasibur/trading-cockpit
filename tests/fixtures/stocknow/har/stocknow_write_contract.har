are Holding as on (\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09a7\u09be\u09b0\u09a3\u09c7\u09b0 \u09a4\u09be\u09b0\u09bf\u0996 (\",\"Share List by\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09a4\u09be\u09b2\u09bf\u0995\u09be\u09b0 \u09ad\u09bf\u09a4\u09cd\u09a4\u09bf\",\"Sharpen decisions\":\"\u09b8\u09bf\u09a6\u09cd\u09a7\u09be\u09a8\u09cd\u09a4 \u09a8\u09c7\u0993\u09af\u09bc\u09be\u09b0 \u09a6\u0995\u09cd\u09b7\u09a4\u09be \u09ac\u09be\u09a1\u09bc\u09be\u09a8\",\"Short Term Loan\":\"\u09b8\u09cd\u09ac\u09b2\u09cd\u09aa\u09ae\u09c7\u09af\u09bc\u09be\u09a6\u09bf \u098b\u09a3\",\"Short term loan\":\"\u09b8\u09cd\u09ac\u09b2\u09cd\u09aa\u09ae\u09c7\u09af\u09bc\u09be\u09a6\u09bf \u098b\u09a3\",\"Show details\":\"\u09ac\u09bf\u09b8\u09cd\u09a4\u09be\u09b0\u09bf\u09a4 \u09a6\u09c7\u0996\u09be\u09a8\",\"Show events in chart\":\"\u099a\u09be\u09b0\u09cd\u099f\u09c7 \u0987\u09ad\u09c7\u09a8\u09cd\u099f \u09a6\u09c7\u0996\u09be\u09a8\",\"Show stats\":\"\u09aa\u09b0\u09bf\u09b8\u0982\u0996\u09cd\u09af\u09be\u09a8 \u09a6\u09c7\u0996\u09be\u09a8\",\"Showing\":\"\u09a6\u09c7\u0996\u09be\u09a8\u09cb \u09b9\u099a\u09cd\u099b\u09c7\",\"Since the previous analysis\":\"\u0986\u0997\u09c7\u09b0 \u09ac\u09bf\u09b6\u09cd\u09b2\u09c7\u09b7\u09a3\u09c7\u09b0 \u09aa\u09b0 \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8\",\"Single\":\"\u098f\u0995\u0995\",\"Small\":\"\u099b\u09cb\u099f\",\"Snapshot updated\":\"\u09a4\u09a5\u09cd\u09af \u09b9\u09be\u09b2\u09a8\u09be\u0997\u09be\u09a6\u09c7\u09b0 \u09b8\u09ae\u09af\u09bc\",\"Sort\":\"\u09b8\u09be\u099c\u09be\u09a8\",\"Source date\":\"\u0989\u09ce\u09b8\u09c7\u09b0 \u09a4\u09be\u09b0\u09bf\u0996\",\"Sources ({count})\":\"\u09a4\u09a5\u09cd\u09af\u09c7\u09b0 \u0989\u09ce\u09b8 ({count})\",\"Spot Shares\":\"\u09b8\u09cd\u09aa\u099f \u09b6\u09c7\u09af\u09bc\u09be\u09b0\",\"Start\":\"\u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09c1\u09a8\",\"Start a conversation by asking about a stock...\":\"\u0995\u09cb\u09a8\u09cb \u09b6\u09c7\u09af\u09bc\u09be\u