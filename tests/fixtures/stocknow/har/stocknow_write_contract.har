u09b8\u09ae\u09af\u09bc\u09b8\u09c0\u09ae\u09be\u09af\u09bc \u0995\u09bf\u099b\u09c1 \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u09ae\u09c2\u09b2\u09cd\u09af\u09c7\u09b0 \u09a4\u09a5\u09cd\u09af \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\u0964\",\"Summary\":\"\u09b8\u09be\u09b0\u09b8\u0982\u0995\u09cd\u09b7\u09c7\u09aa\",\"News preview\":\"\u09b8\u0982\u09ac\u09be\u09a6\u09c7\u09b0 \u09b8\u0982\u0995\u09cd\u09b7\u09bf\u09aa\u09cd\u09a4 \u0985\u0982\u09b6\",\"English original\":\"\u09ae\u09c2\u09b2 \u0987\u0982\u09b0\u09c7\u099c\u09bf \u09b8\u0982\u09ac\u09be\u09a6\",\"Bangla translation\":\"\u09ac\u09be\u0982\u09b2\u09be \u0985\u09a8\u09c1\u09ac\u09be\u09a6\",\"Bangla is unavailable for this view. Showing English.\":\"\u098f\u0987 \u0985\u0982\u09b6\u099f\u09bf \u09ac\u09be\u0982\u09b2\u09be\u09af\u09bc \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\u0964 \u0987\u0982\u09b0\u09c7\u099c\u09bf\u09a4\u09c7 \u09a6\u09c7\u0996\u09be\u09a8\u09cb \u09b9\u099a\u09cd\u099b\u09c7\u0964\",\"English is unavailable for this view. Showing Bangla.\":\"\u098f\u0987 \u0985\u0982\u09b6\u099f\u09bf \u0987\u0982\u09b0\u09c7\u099c\u09bf\u09a4\u09c7 \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\u0964 \u09ac\u09be\u0982\u09b2\u09be\u09af\u09bc \u09a6\u09c7\u0996\u09be\u09a8\u09cb \u09b9\u099a\u09cd\u099b\u09c7\u0964\",\"Market news\":\"\u09ac\u09be\u099c\u09be\u09b0\u09c7\u09b0 \u09b8\u0982\u09ac\u09be\u09a6\",\"Possible sentiment of this announcement.\":\"\u098f\u0987 \u09b8\u0982\u09ac\u09be\u09a6\u09c7\u09b0 \u09b8\u09ae\u09cd\u09ad\u09be\u09ac\u09cd\u09af \u09aa\u09cd\u09b0\u09ad\u09be\u09ac\u0964\",\"Possible sentiment: {sentiment}\":\"\u09b8\u09ae\u09cd\u09ad\u09be\u09ac\u09cd\u09af \u09aa\u09cd\u09b0\u09ad\u09be\u09ac: {sentiment}\",\"Positive\":\"\u0987\u09a4\u09bf\u09ac\u09be\u099a\u0995\",\"Negative\":\"\u09a8\u09c7\u09a4\u09bf\u09ac\u09be\u099a\u0995\",\"News text is unavailable.\":\"\u09b8\u0982\u09ac\u09be\u09a6\u09c7\u09b0 \u09b2\u09c7\u0996\u09be \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\u0964\",\"Hide full news\":\"\u09b8\u09ae\u09cd\u09aa\u09c2\u09b0\u09cd\u09a3 \u09b8\u0982\u09ac\u09be\u09a6 \u09b2\u09c1\u0995\u09be\u09a8\",\"Read full news\":\"\u09b8\u09ae\u09cd\u09aa\u09c2\u09b0\u09cd\u09a3 \u09b8\u0982\u09ac\u09be\u09a6 \u09aa\u09a1\u09bc\u09c1\u09a8\",\"Full news\":\"\u09b8\u09ae\u09cd\u09aa\u09c2\u09b0\u09cd\u09a3 \u09b8\u0982\u09ac\u09be\u09a6\",\"News in brief\":\"\u09b8\u0982\u0995\u09cd\u09b7\u09c7\u09aa\u09c7 \u09b8\u0982\u09ac\u09be\u09a6\",\"Summaries first. Open any item for the full news.\":\"\u0986\u0997\u09c7 \u09b8\u09be\u09b0\u09b8\u0982\u0995\u09cd\u09b7\u09c7\u09aa \u09a6\u09c7\u0996\u09c1\u09a8\u0964 \u09b8\u09ae\u09cd\u09aa\u09c2\u09b0\u09cd\u09a3 \u09b8\u0982\u09ac\u09be\u09a6 \u09aa\u09a1\u09bc\u09a4\u09c7 \u09af\u09c7\u0995\u09cb\u09a8\u09cb\u099f\u09bf \u0996\u09c1\u09b2\u09c1\u09a8\u0964\",\"Full news in your selected language.\":\"\u0986\u09aa\u09a8\u09be\u09b0 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09bf\u09a4 \u09ad\u09be\u09b7\u09be\u09af\u09bc \u09b8\u09ae\u09cd\u09aa\u09c2\u09b0\u09cd\u09a3 \u09b8\u0982\u09ac\u09be\u09a6\u0964\",\"Read in\":\"\u09aa\u09a1\u09bc\u09be\u09b0 \u09ad\u09be\u09b7\u09be\",\"News language\":\"\u09b8\u0982\u09ac\u09be\u09a6\u09c7\u09b0 \u09ad\u09be\u09b7\u09be\",\"News view\":\"\u09b8\u0982\u09ac\u09be\u09a6 \u09a6\u09c7\u0996\u09be\u09b0 \u09a7\u09b0\u09a8\",\"Check the original for full details.\":\"\u09aa\u09c2\u09b0\u09cd\u09a3 \u09ac\u09bf\u09ac\u09b0\u09a3 \u099c\u09be\u09a8\u09a4\u09c7 \u09ae\u09c2\u09b2 \u09b8\u0982\u09ac\u09be\u09a6 \u09a6\u09c7\u0996\u09c1\u09a8\u0964\",\"Loading news\u2026\":\"\u09b8\u0982\u09ac\u09be\u09a6 \u09b2\u09cb\u09a1 \u09b9\u099a\u09cd\u099b\u09c7\u2026\",\"No news yet\":\"\u098f\u0996\u09a8\u09cb \u0995\u09cb\u09a8\u09cb \u09b8\u0982\u09ac\u09be\u09a6 \u09a8\u09c7\u0987\",\"New announcements will appear here.\":\"\u09a8\u0