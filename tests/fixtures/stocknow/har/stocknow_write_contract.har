"\u09ef \u09ae\u09be\u09b8\",\"< Back\":\"< \u09ab\u09bf\u09b0\u09c7 \u09af\u09be\u09a8\",\"@AVG\":\"@\u0997\u09a1\u09bc\",\"A\":\"A\",\"A good alarm turns VIP into a quiet market assistant while you are away.\":\"\u0986\u09aa\u09a8\u09bf \u09ac\u09cd\u09af\u09b8\u09cd\u09a4 \u09a5\u09be\u0995\u09b2\u09c7\u0993 \u09ad\u09be\u09b2\u09cb\u09ad\u09be\u09ac\u09c7 \u09b8\u09c7\u099f \u0995\u09b0\u09be \u0985\u09cd\u09af\u09be\u09b2\u09be\u09b0\u09cd\u09ae \u09ac\u09be\u099c\u09be\u09b0\u09c7\u09b0 \u0996\u09ac\u09b0 \u099c\u09be\u09a8\u09bf\u09af\u09bc\u09c7 \u09a6\u09c7\u09ac\u09c7\u0964\",\"A strong stock is more useful when the month also has a repeating historical pattern.\":\"\u09b6\u0995\u09cd\u09a4\u09bf\u09b6\u09be\u09b2\u09c0 \u09b6\u09c7\u09af\u09bc\u09be\u09b0\u09c7\u09b0 \u09b8\u0999\u09cd\u0997\u09c7 \u09ae\u09be\u09b8\u09c7\u09b0 \u0990\u09a4\u09bf\u09b9\u09be\u09b8\u09bf\u0995 \u09aa\u09cd\u09b0\u09ac\u09a3\u09a4\u09be\u0993 \u09ae\u09bf\u09b2\u09b2\u09c7 \u09ac\u09bf\u09b6\u09cd\u09b2\u09c7\u09b7\u09a3 \u0986\u09b0\u0993 \u0995\u09be\u099c\u09c7 \u0986\u09b8\u09c7\u0964\",\"A-Z\":\"\u09ac\u09b0\u09cd\u09a3\u09be\u09a8\u09c1\u0995\u09cd\u09b0\u09ae\u09c7\",\"ADVANCED\":\"\u09ac\u09c7\u09a1\u09bc\u09c7\u099b\u09c7\",\"ATR volatility\":\"ATR \u09ad\u09cb\u09b2\u09be\u099f\u09bf\u09b2\u09bf\u099f\u09bf\",\"Above\":\"\u0989\u09aa\u09b0\u09c7\",\"Accumulation and distribution describe possible price patterns, not verified investor activity.\":\"\u0985\u09cd\u09af\u09be\u0995\u09c1\u09ae\u09c1\u09b2\u09c7\u09b6\u09a8 \u0993 \u09a1\u09bf\u09b8\u09cd\u099f\u09cd\u09b0\u09bf\u09ac\u09bf\u0989\u09b6\u09a8 \u098f\u0996\u09be\u09a8\u09c7 \u09b8\u09ae\u09cd\u09ad\u09be\u09ac\u09cd\u09af \u09aa\u09cd\u09b0\u09be\u0987\u09b8 \u09aa\u09cd\u09af\u09be\u099f\u09be\u09b0\u09cd\u09a8 \u09ac\u09cb\u099d\u09be\u09af\u09bc, \u09ac\u09bf\u09a8\u09bf\u09af\u09bc\u09cb\u0997\u0995\u09be\u09b0\u09c0\u09a6\u09c7\u09b0 \u09af\u09be\u099a\u09be\u0987\u0995\u09c3\u09a4 \u0995\u09be\u09b0\u09cd\u09af\u0995\u09cd\u09b0\u09ae \u09a8\u09af\u09bc\u0964\",\"Active\":\"\u099a\u09be\u09b2\u09c1\",\"Ad in\":\"\u09ac\u09bf\u099c\u09cd\u099e\u09be\u09aa\u09a8 \u0986\u09b8\u09ac\u09c7\",\"Ad loading...\":\"\u09ac\u09bf\u099c\u09cd\u099e\u09be\u09aa\u09a8 \u09b2\u09cb\u09a1 \u09b9\u099a\u09cd\u099b\u09c7...\",\"Add Share\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\",\"Add a share or create a portfolio entry to see it here.\":\"\u098f\u0996\u09be\u09a8\u09c7 \u09a6\u09c7\u0996\u09a4\u09c7 \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8 \u09ac\u09be \u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993\u09a4\u09c7 \u09af\u09c1\u0995\u09cd\u09a4 \u0995\u09b0\u09c1\u09a8\u0964\",\"Add favorite\":\"\u09aa\u099b\u09a8\u09cd\u09a6\u09c7\u09b0 \u09a4\u09be\u09b2\u09bf\u0995\u09be\u09af\u09bc \u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\",\"Add favorites so the dashboard can produce personal signals.\":\"\u09a1\u09cd\u09af\u09be\u09b6\u09ac\u09cb\u09b0\u09cd\u09a1\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09aa\u09cd\u09b0\u09be\u09b8\u0999\u09cd\u0997\u09bf\u0995 \u09a4\u09a5\u09cd\u09af \u09aa\u09c7\u09a4\u09c7 \u09aa\u099b\u09a8\u09cd\u09a6\u09c7\u09b0 \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\u0964\",\"Add favorites to turn VIP into a personal market radar.\":\"\u09a8\u09bf\u099c\u09c7\u09b0 \u09aa\u099b\u09a8\u09cd\u09a6\u09ae\u09a4\u09cb \u09ac\u09be\u099c\u09be\u09b0 \u09aa\u09b0\u09cd\u09af\u09ac\u09c7\u0995\u09cd\u09b7\u09a3\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\u0964\",\"Add your first share to start tracking it here.\":\"\u098f\u0996\u09be\u09a8\u09c7 \u09a8\u099c\u09b0 \u09b0\u09be\u0996\u09a4\u09c7 \u09aa\u09cd\u09b0\u09a5\u09ae \u09b6\u09c7\u09af\u09bc\u09be\u09b0\u099f\u09bf \u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\u0964\",\"Address\":\"\u09a0\u09bf\u0995\u09be\u09a8\u09be\",\"Advanced\":\"\u0989\u09a8\u09cd\u09a8\u09a4\",\"Advanced Screener\":\"\u0989\u09a8\u09cd\u09a8\u09a4 \u09b8\u09cd\u0995\u09cd\u09b0\u09bf\u09a8\u09be\u09b0\",\"Advancing\":\"\u09ac\u09c7\u09a1\u09bc\u09c7\u099b\u09c7\",\"After sending the payment please wait. Once we receive the payment we will process your order as soon as possible.\":\"\u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f \u09aa\u09be\u09a0\u09be\u09a8\u09cb\u09b0 \u09aa\u09b0 \u0985\u09aa\u09c7\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09c1\u09a8\u0964 \u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f \u09aa\u09be\u0993\u09af\u09bc\u09be\u09b0 \u09b8\u0999\u09cd\u0997\u09c7 \u09b8\u0999\u09cd\u0997\u09c7 \u0986\u09ae\u09b0\u09be \u09af\u09a4 \u09a6\u09cd\u09b0\u09c1\u09a4 \u09b8\u09ae\u09cd\u09ad\u09ac \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09b0\u09cd\u09a1\u09be\u09b0\u099f\u09bf \u09b8\u09ae\u09cd\u09aa\u09a8\u09cd\u09a8 \u0995\u09b0\u09ac\u0964\",\"Alert On\":\"\u0985\u09cd\u09af\u09be\u09b2\u09be\u09b0\u09cd\u099f \u099a\u09be\u09b2\u09c1\",\"All\":\"\u09b8\u09ac\",\"All Shares\":\"\u09b8\u09ac \u09b6\u09c7\u09af\u09bc\u09be\u09b0\",\"Already have an account?\":\"\u0986\u0997\u09c7\u0987 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u0986\u099b\u09c7?\",\"Analysis\":\"\u09ac\u09bf\u09b6\u09cd\u09b2\u09c7\u09b7\u09a3\",\"Outlook\":\"\u09ac\u09be\u099c\u09be\u09b0\u09c7\u09b0 \u09a6\u09bf\u0995\",\"Market phase\":\"\u09ac\u09be\u099c\u09be\u09b0\u09c7\u09b0 \u09aa\u09b0\u09cd\u09af\u09be\u09af\u09bc\",\"Unlocking analysis...\":\"\u09ac\u09bf\u09b6\u09cd\u09b2\u09c7\u09b7\u09a3 \u0986\u09a8\u09b2\u0995 \u09b9\u099a\u09cd\u099b\u09c7...\",\"Analysis available\":\"\u09ac\u09bf\u09b6\u09cd\u09b2\u09c7\u09b7\u09a3 \u09aa\u09be\u0993\u09af\u09bc\u09be \u0997\u09c7\u099b\u09c7\",\"Analysis copied to clipboard\":\"\u09ac\u09bf\u09b6\u09cd\u09b2\u09c7\u09b7\u09a3 \u0995\u09cd\u09b2\u09bf\u09aa\u09ac\u09cb\u09b0\u09cd\u09a1\u09c7 \u0995\u09aa\u09bf \u09b9\u09af\u09bc\u09c7\u099b\u09c7\",\"Analysis copied.\":\"\u09ac\u09bf\u09b6\u09cd\u09b2\u09c7\u09b7\u09a3 \u0995\u09aa\u09bf \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u0964\",\"Analysis is being prepared.\":\"\u09ac\u09bf\u09b6\u09cd\u09b2\u09c7\u09b7\u09a3 \u09aa\u09cd\u09b0\u09b8\u09cd\u09a4\u09c1\u09a4 \u0995\u09b0\u09be \u09b9\u099a\u09cd\u099b\u09c7\u0964\",\"Analysis is unavailable for this stock.\":\"\u098f\u0987 \u09b6\u09c7\u09af\u09bc\u09be\u09b0\u09c7\u09b0 \u09ac\u09bf\u09b6\u09cd\u09b2\u09c7\u09b7\u09a3 \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u099a\u09cd\u099b\u09c7 \u09a8\u09be\u0964\",\"Analysis summary\":\"\u09ac\u09bf\u09b6\u09cd\u09b2\u09c7\u09b7\u09a3\u09c7\u09b0 \u09b8\u09be\u09b0\u09b8\u0982\u0995\u09cd\u09b7\u09c7\u09aa\",\"Announcement source\":\"\u0998\u09cb\u09b7\u09a3\u09be\u09b0 \u0989\u09ce\u09b8\",\"Announcements\":\"\u0998\u09cb\u09b7\u09a3\u09be\",\"Annual\":\"\u09ac\u09be\u09b0\u09cd\u09b7\u09bf\u0995\",\"Annualized based on {period} [{value}] as on {date}\":\"{date} \u09a4\u09be\u09b0\u09bf\u0996\u09c7 {period} [{value}]-\u098f\u09b0 \u09ad\u09bf\u09a4\u09cd\u09a4\u09bf\u09a4\u09c7 \u09ac\u09be\u09b0\u09cd\u09b7\u09bf\u0995 \u09b9\u09bf\u09b8\u09be\u09ac\",\"Annualized estimate\":\"\u09ac\u09be\u09b0\u09cd\u09b7\u09bf\u0995 \u0986\u09a8\u09c1\u09ae\u09be\u09a8\u09bf\u0995 \u09b9\u09bf\u09b8\u09be\u09ac\",\"Apply\":\"\u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\",\"Apr\":\"\u098f\u09aa\u09cd\u09b0\u09bf\u09b2\",\"Are you passionate about finance and investing? Do you have a knack for analyzing data and identifying market trends? If so, we have the perfect opportunity for you.\":\"\u0985\u09b0\u09cd\u09a5\u09a8\u09c0\u09a4\u09bf \u0993 \u09ac\u09bf\u09a8\u09bf\u09af\u09bc\u09cb\u0997\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0986\u0997\u09cd\u09b0\u09b9 \u0986\u099b\u09c7? \u09a4\u09a5\u09cd\u09af \u09ac\u09bf\u09b6\u09cd\u09b2\u09c7\u09b7\u09a3 \u098f\u09ac\u0982 \u09ac\u09be\u099c\u09be\u09b0\u09c7\u09b0