95\u09b0\u09a3\u09c7 \u09aa\u09be\u09a0\u09be\u09a8\u0964\",\"Send to New\":\"\u09a8\u09a4\u09c1\u09a8 \u09b8\u0982\u09b8\u09cd\u0995\u09b0\u09a3\u09c7 \u09aa\u09be\u09a0\u09be\u09a8\",\"Send to New Portfolio\":\"\u09a8\u09a4\u09c1\u09a8 \u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993\u09a4\u09c7 \u09aa\u09be\u09a0\u09be\u09a8\",\"Series\":\"\u09b8\u09ae\u09af\u09bc\u0995\u09cd\u09b0\u09ae\",\"Share\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0\",\"Shares held\":\"\u09a7\u09be\u09b0\u09a3\u0995\u09c3\u09a4 \u09b6\u09c7\u09af\u09bc\u09be\u09b0\",\"Shares: {value} \u2022 Avg: {value2}\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0: {value} \u2022 \u0997\u09a1\u09bc: {value2}\",\"Show Ledger\":\"\u09b2\u09c7\u099c\u09be\u09b0 \u09a6\u09c7\u0996\u09c1\u09a8\",\"Showing latest transactions on top of list\":\"\u09b8\u09b0\u09cd\u09ac\u09b6\u09c7\u09b7 \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 \u09a4\u09be\u09b2\u09bf\u0995\u09be\u09b0 \u0993\u09aa\u09b0\u09c7 \u09a6\u09c7\u0996\u09be\u09a8\u09cb \u09b9\u099a\u09cd\u099b\u09c7\",\"Sort by\":\"\u09b8\u09be\u099c\u09be\u09a8\u09cb\u09b0 \u09a7\u09b0\u09a8\",\"Start Value\":\"\u09b6\u09c1\u09b0\u09c1\u09b0 \u09ae\u09c2\u09b2\u09cd\u09af\",\"Start {value} \u00b7 Change {value2} \u00b7 End {value3}\":\"\u09b6\u09c1\u09b0\u09c1 {value} \u00b7 \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8 {value2} \u00b7 \u09b6\u09c7\u09b7 {value3}\",\"Start: {value}\":\"\u09b6\u09c1\u09b0\u09c1: {value}\",\"Stock Value\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0\u09c7\u09b0 \u09ae\u09c2\u09b2\u09cd\u09af\",\"Stock {value}\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0 {value}\",\"Stop Loss %, eg:95\":\"\u09b8\u09cd\u099f\u09aa \u09b2\u09b8 %, \u09af\u09c7\u09ae\u09a8: \u09ef\u09eb\",\"Stop Loss/Take Profit\":\"\u09b8\u09cd\u099f\u09aa \u09b2\u09b8/\u09b2\u09be\u09ad \u0997\u09cd\u09b0\u09b9\u09a3\",\"Stop Loss/Take Profit for {value}\":\"{value}-\u098f\u09b0 \u09b8\u09cd\u099f\u09aa \u09b2\u09b8/\u09b2\u09be\u09ad \u0997\u09cd\u09b0\u09b9\u09a3\",\"Stop is on the wrong side of entry for a {value} trade.\":\"{value} \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b8\u09cd\u099f\u09aa\u09c7\u09b0 \u09a6\u09be\u09ae \u09aa\u09cd\u09b0\u09ac\u09c7\u09b6\u09ae\u09c2\u09b2\u09cd\u09af\u09c7\u09b0 \u09ad\u09c1\u09b2 \u09a6\u09bf\u0995\u09c7 \u09b0\u09af\u09bc\u09c7\u099b\u09c7\u0964\",\"Stop price\":\"\u09b8\u09cd\u099f\u09aa\u09c7\u09b0 \u09a6\u09be\u09ae\",\"Submit\":\"\u099c\u09ae\u09be \u09a6\u09bf\u09a8\",\"Submitting...\":\"\u099c\u09ae\u09be \u09a6\u09c7\u0993\u09af\u09bc\u09be \u09b9\u099a\u09cd\u099b\u09c7...\",\"Success\":\"\u09b8\u09ab\u09b2\",\"Successfully updated!\":\"\u0986\u09aa\u09a1\u09c7\u099f \u09b9\u09af\u09bc\u09c7\u099b\u09c7!\",\"Switch To New Portfolio\":\"\u09a8\u09a4\u09c1\u09a8 \u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993\u09a4\u09c7 \u09af\u09be\u09a8\",\"Switch to Old Portfolio\":\"\u09aa\u09c1\u09b0\u09cb\u09a8\u09cb \u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993\u09a4\u09c7 \u09af\u09be\u09a8\",\"TOTAL AMOUNT\":\"\u09ae\u09cb\u099f \u0985\u09b0\u09cd\u09a5\",\"TP: {value}\":\"\u09b2\u09be\u09ad \u0997\u09cd\u09b0\u09b9\u09a3: {value}\",\"TRADE DATE\":\"\u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u09c7\u09b0 \u09a4\u09be\u09b0\u09bf\u0996\",\"TWR %\":\"\u09b8\u09ae\u09af\u09bc\u09ad\u09bf\u09a4\u09cd\u09a4\u09bf\u0995 \u09b0\u09bf\u099f\u09be\u09b0\u09cd\u09a8 %\",\"Take Profit %, eg:110\":\"\u09b2\u09be\u09ad \u0997\u09cd\u09b0\u09b9\u09a3 %, \u09af\u09c7\u09ae\u09a8: \u09e7\u09e7\u09e6\",\"Target is on the wrong side of entry for a {value} trade.\":\"{value} \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b2\u0995\u09cd\u09b7\u09cd\u09af\u09ae\u09c2\u09b2\u09cd\u09af \u09aa\u09cd\u09b0\u09ac\u09c7\u09b6\u09ae\u09c2\u09b2\u09cd\u09af\u09c7\u09b0 \u09ad\u09c1\u09b2 \u09a6\u09bf\u0995\u09c7 \u09b0\u09af\u09bc\u09c7\u099b\u09c7\u0964\",\"Target price\":\"\u09b2\u0995\u09cd\u09b7\u09cd\u09af\u09ae\u09c2\u09b2\u09cd\u09af\",\"The base instrument used as the reference for the displayed correlation column.\":\"\u09a6\u09c7\u0996\u09be\u09a8\u09cb \u09b8\u09b9\u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7\u09b0 \u0995\u09b2\u09be\u09ae\u09c7 \u09a4\u09c1\u09b2\u09a8\u09be\u09b0 \u09ad\u09bf\u09a4\u09cd\u09a4\u09bf \u09b9\u09bf\u09b8\u09c7\u09ac\u09c7 \u09ac\u09cd\u09af\u09ac\u09b9\u09c3\u09a4 \u09b6\u09c7\u09af\u09bc\u09be\u09b0\u0964\",\"The date range used to compute these metrics (lookback window).\":\"\u098f\u0987 \u09aa\u09b0\u09bf\u09ae\u09be\u09aa\u0997\u09c1\u09b2\u09cb \u09b9\u09bf\u09b8\u09be\u09ac \u0995\u09b0\u09a4\u09c7 \u09ac\u09cd\u09af\u09ac\u09b9\u09c3\u09a4 \u09b8\u09ae\u09af\u09bc\u09b8\u09c0\u09ae\u09be\u0964\",\"The share and its holding record will be removed from this portfolio. This action cannot be undone.\":\"\u098f\u0987 \u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993 \u09a5\u09c7\u0995\u09c7 \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u0993 \u09b8\u09c7\u099f\u09bf \u09a7\u09be\u09b0\u09a3\u09c7\u09b0 \u09b0\u09c7\u0995\u09b0\u09cd\u09a1 \u09ae\u09c1\u099b\u09c7 \u09ab\u09c7\u09b2\u09be \u09b9\u09ac\u09c7\u0964 \u098f\u099f\u09bf \u0986\u09b0 \u09ab\u09bf\u09b0\u09bf\u09af\u09bc\u09c7 \u0986\u09a8\u09be \u09af\u09be\u09ac\u09c7 \u09a8\u09be\u0964\",\"There are no holdings available to sell in this portfolio.\":\"\u098f\u0987 \u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993\u09a4\u09c7 \u09ac\u09bf\u0995\u09cd\u09b0\u09af\u09bc\u09af\u09cb\u0997\u09cd\u09af \u0995\u09cb\u09a8\u09cb \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09a8\u09c7\u0987\u0964\",\"This old portfolio system is deprecated. Please migrate to the new Portfolio system. Will be removed after September, 2026.\":\"\u098f\u0987 \u09aa\u09c1\u09b0\u09cb\u09a8\u09cb \u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993 \u09ac\u09cd\u09af\u09ac\u09b8\u09cd\u09a5\u09be \u0986\u09b0 \u099a\u09be\u09b2\u09c1 \u09b0\u09be\u0996\u09be \u09b9\u09ac\u09c7 \u09a8\u09be\u0964 \u09a8\u09a4\u09c1\u09a8 \u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993 \u09ac\u09cd\u09af\u09ac\u09b8\u09cd\u09a5\u09be\u09af\u09bc \u09b8\u09cd\u09a5\u09be\u09a8\u09be\u09a8\u09cd\u09a4\u09b0 \u0995\u09b0\u09c1\u09a8\u0964 \u09e8\u09e6\u09e8\u09ec \u09b8\u09be\u09b2\u09c7\u09b0 \u09b8\u09c7\u09aa\u09cd\u099f\u09c7\u09ae\u09cd\u09ac\u09b0\u09c7\u09b0 \u09aa\u09b0 \u098f\u099f\u09bf \u09b8\u09b0\u09bf\u09af\u09bc\u09c7 \u09a8\u09c7\u0993\u09af\u09bc\u09be \u09b9\u09ac\u09c7\u0964\",\"This statement is generated automatically. Market data is subject to delays.\":\"\u098f\u0987 \u09ac\u09bf\u09ac\u09b0\u09a3\u09c0 \u09b8\u09cd\u09ac\u09af\u09bc\u0982\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09ad\u09be\u09ac\u09c7 \u09a4\u09c8\u09b0\u09bf\u0964 \u09ac\u09be\u099c\u09be\u09b0\u09c7\u09b0 \u09a4\u09a5\u09cd\u09af \u0986\u09b8\u09a4\u09c7 \u09a6\u09c7\u09b0\u09bf \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964\",\"This will delete the complete holding\":\"\u09a7\u09be\u09b0\u09a3\u0995\u09c3\u09a4 \u09b6\u09c7\u09af\u09bc\u09be\u09b0\u09c7\u09b0 \u09b8\u09ae\u09cd\u09aa\u09c2\u09b0\u09cd\u09a3 \u09b0\u09c7\u0995\u09b0\u09cd\u09a1 \u09ae\u09c1\u099b\u09c7 \u09ab\u09c7\u09b2\u09be \u09b9\u09ac\u09c7\",\"Today\":\"\u0986\u099c\",\"Today\\'s P/L\":\"\u0986\u099c\u0995\u09c7\u09b0 \u09b2\u09be\u09ad/\u0995\u09cd\u09b7\u09a4\u09bf\",\"Top Positions\":\"\u09aa\u09cd\u09b0\u09a7\u09be\u09a8 \u09ac\u09bf\u09a8\u09bf\u09af\u09bc\u09cb\u0997\",\"Total\":\"\u09ae\u09cb\u099f\",\"Total Amount\":\"\u09ae\u09cb\u099f \u0985\u09b0\u09cd\u09a5\",\"Total Asset Value\":\"\u09ae\u09cb\u099f \u09b8\u09ae\u09cd\u09aa\u09a6\u09ae\u09c2\u09b2\u09cd\u09af\",\"Total Cost\":\"\u09ae\u09cb\u099f \u0995\u09cd\u09b0\u09af\u09bc\u09ae\u09c2\u09b2\u09cd\u09af\",\"Total Invested\":\"\u09ae\u09cb\u099f \u09ac\u09bf\u09a8\u09bf\u09af\u09bc\u09cb\u0997\",\"Total Loss\":\"\u09ae\u09cb\u099f \u0995\u09cd\u09b7\u09a4\u09bf\",\"Total P/L\":\"\u09ae\u09cb\u099f \u09b2\u09be\u09ad/\u0995\u09cd\u09b7\u09a4\u09bf\",\"Total Profit\":\"\u09ae\u09cb\u099f \u09b2\u09be\u09ad\",\"Total Sell\":\"\u09ae\u09cb\u099f \u09ac\u09bf\u0995\u09cd\u09b0\u09af\u09bc\u09ae\u09c2\u09b2\u09cd\u09af\",\"Total Stock\":\"\u09ae\u09cb\u099f \u09b6\u09c7\u09af\u09bc\u09be\u09b0\u09ae\u09c2\u09b2\u09cd\u09af\",\"Total Value\":\"\u09ae\u09cb\u099f \u09ae\u09c2\u09b2\u09cd\u09af\",\"Total portfolio value used for risk calculations in this panel (typically stock value + cash).\":\"\u098f\u0987 \u09aa\u09cd\u09af\u09be\u09a8\u09c7\u09b2\u09c7 \u099d\u09c1\u0981\u0995\u09bf \u09b9\u09bf\u09b8\u09be\u09ac \u0995\u09b0\u09a4\u09c7 \u09ac\u09cd\u09af\u09ac\u09b9\u09c3\u09a4 \u09ae\u09cb\u099f \u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993 \u09ae\u09c2\u09b2\u09cd\u09af (\u09b8\u09be\u09a7\u09be\u09b0\u09a3\u09a4 \u09b6\u09c7\u09af\u09bc\u09be\u09b0\u09c7\u09b0 \u09ae\u09c2\u09b2\u09cd\u09af + \u09a8\u0997\u09a6)\u0964\",\"Total \u09f3{value}\":\"\u09ae\u09cb\u099f \u09f3{value}\",\"Totals\":\"\u09b8\u09b0\u09cd\u09ac\u09ae\u09cb\u099f\",\"Trade Failed: {value}\":\"\u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 \u09b8\u09ae\u09cd\u09aa\u09a8\u09cd\u09a8 \u09b9\u09af\u09bc\u09a8\u09bf: {value}\",\"Trade Insight\":\"\u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u09c7\u09b0 \u09ac\u09bf\u09b6\u09cd\u09b2\u09c7\u09b7\u09a3\",\"Trade Planner\":\"\u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 \u09aa\u09b0\u09bf\u0995\u09b2\u09cd\u09aa\u09a8\u09be\",\"Trade Planner & Risk Management\":\"\u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 \u09aa\u09b0\u09bf\u0995\u09b2\u09cd\u09aa\u09a8\u09be \u0993 \u099d\u09c1\u0981\u0995\u09bf \u09ac\u09cd\u09af\u09ac\u09b8\u09cd\u09a5\u09be\u09aa\u09a8\u09be\",\"Transaction History\":\"\u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u09c7\u09b0 \u0987\u09a4\u09bf\u09b9\u09be\u09b8\",\"Trd Comsn\":\"\u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 \u0995\u09ae\u09bf\u09b6\u09a8\",\"Type\":\"\u09a7\u09b0\u09a8\",\"Unable to load portfolio\":\"\u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993 \u09b2\u09cb\u09a1 \u0995\u09b0\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\",\"Uncategorized\":\"\u0996\u09be\u09a4 \u09a8\u09bf\u09b0\u09cd\u09a7\u09be\u09b0\u09bf\u09a4 \u09a8\u09af\u09bc\",\"Unknown\":\"\u0985\u099c\u09be\u09a8\u09be\",\"Unrealize Gain/Loss\":\"\u0985\u09a8\u09b0\u09cd\u099c\u09bf\u09a4 \u09b2\u09be\u09ad/\u0995\u09cd\u09b7\u09a4\u09bf\",\"Unrealized\":\"\u0985\u09a8\u09b0\u09cd\u099c\u09bf\u09a4\",\"Unrealized P/L\":\"\u0985\u09a8\u09b0\u09cd\u099c\u09bf\u09a4 \u09b2\u09be\u09ad/\u0995\u09cd\u09b7\u09a4\u09bf\",\"Untitled Portfolio\":\"\u09a8\u09be\u09ae\u09b9\u09c0\u09a8 \u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993\",\"Update Portfolio\":\"\u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993 \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09c1\u09a8\",\"Updating Portfolio...\":\"\u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993 \u0986\u09aa\u09a1\u09c7\u099f \u09b9\u099a\u09cd\u099b\u09c7...\",\"Updating portfolio...\":\"\u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993 \u0986\u09aa\u09a1\u09c7\u099f \u09b9\u099a\u09cd\u099b\u09c7...\",\"User\":\"\u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\",\"VaR ({value})\":\"\u09ad\u09bf\u098f\u0986\u09b0 ({value})\",\"Value\":\"\u09ae\u09c2\u09b2\u09cd\u09af\",\"Value at Risk (VaR): an estimate of the loss threshold that should not be exceeded on most days at the selected confidence level (e.g., 0.95). Not a guaranteed worst-case.\":\"\u09ad\u09cd\u09af\u09be\u09b2\u09c1 \u0985\u09cd\u09af\u09be\u099f \u09b0\u09bf\u09b8\u09cd\u0995 (\u09ad\u09bf\u098f\u0986\u09b0): \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09bf\u09a4 \u0986\u09b8\u09cd\u09a5\u09be\u09b0 \u09ae\u09be\u09a4\u09cd\u09b0\u09be\u09af\u09bc (\u09af\u09c7\u09ae\u09a8 \u09e6.\u09ef\u09eb) \u0985\u09a7\u09bf\u0995\u09be\u0982\u09b6 \u09a6\u09bf\u09a8\u09c7 \u0995\u09cd\u09b7\u09a4\u09bf \u09af\u09c7 \u09b8\u09c0\u09ae\u09be \u099b\u09be\u09a1\u09bc\u09be\u09ac\u09c7 \u09a8\u09be \u09ac\u09b2\u09c7 \u0985\u09a8\u09c1\u09ae\u09be\u09a8 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u0964 \u098f\u099f\u09bf \u09b8\u09b0\u09cd\u09ac\u09cb\u099a\u09cd\u099a \u09b8\u09ae\u09cd\u09ad\u09be\u09ac\u09cd\u09af \u0995\u09cd\u09b7\u09a4\u09bf\u09b0 \u09a8\u09bf\u09b6\u09cd\u099a\u09af\u09bc\u09a4\u09be \u09a8\u09af\u09bc\u0964\",\"Value: {value}\":\"\u09ae\u09c2\u09b2\u09cd\u09af: {value}\",\"View\":\"\u09a6\u09c7\u0996\u09c1\u09a8\",\"View Chart\":\"\u099a\u09be\u09b0\u09cd\u099f \u09a6\u09c7\u0996\u09c1\u09a8\",\"Vol(20)\":\"\u0985\u09b8\u09cd\u09a5\u09bf\u09b0\u09a4\u09be (\u09e8\u09e6)\",\"Vol(20): {value}%/day\":\"\u0985\u09b8\u09cd\u09a5\u09bf\u09b0\u09a4\u09be (\u09e8\u09e6): {value}%/\u09a6\u09bf\u09a8\",\"Volatility (20): standard deviation of daily returns over the last 20 trading days, shown as %/day.\":\"\u0985\u09b8\u09cd\u09a5\u09bf\u09b0\u09a4\u09be (\u09e8\u09e6): \u09b8\u09b0\u09cd\u09ac\u09b6\u09c7\u09b7 \u09e8\u09e6 \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 \u09a6\u09bf\u09a8\u09c7\u09b0 \u09a6\u09c8\u09a8\u09bf\u0995 \u09b0\u09bf\u099f\u09be\u09b0\u09cd\u09a8\u09c7\u09b0 \u09ae\u09be\u09a8\u0995 \u09ac\u09bf\u099a\u09cd\u09af\u09c1\u09a4\u09bf, %/\u09a6\u09bf\u09a8 \u09b9\u09bf\u09b8\u09c7\u09ac\u09c7 \u09a6\u09c7\u0996\u09be\u09a8\u09cb \u09b9\u09af\u09bc\u0964\",\"Volatility (20-day)\":\"\u0985\u09b8\u09cd\u09a5\u09bf\u09b0\u09a4\u09be (\u09e8\u09e6 \u09a6\u09bf\u09a8)\",\"Volatility (Annual)\":\"\u0985\u09b8\u09cd\u09a5\u09bf\u09b0\u09a4\u09be (\u09ac\u09be\u09b0\u09cd\u09b7\u09bf\u0995)\",\"Volume\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0\u09c7\u09b0 \u09aa\u09b0\u09bf\u09ae\u09be\u09a3\",\"WITHDRAW\":\"\u0989\u09a4\u09cd\u09a4\u09cb\u09b2\u09a8\",\"Weight: {value}\":\"\u0985\u09a8\u09c1\u09aa\u09be\u09a4: {value}\",\"Withdraw\":\"\u0989\u09a4\u09cd\u09a4\u09cb\u09b2\u09a8\",\"Withdrawals\":\"\u0989\u09a4\u09cd\u09a4\u09cb\u09b2\u09bf\u09a4 \u0985\u09b0\u09cd\u09a5\",\"Worst\":\"\u09b8\u09b0\u09cd\u09ac\u09a8\u09bf\u09ae\u09cd\u09a8\",\"Worst 1-Day Return\":\"\u098f\u0995 \u09a6\u09bf\u09a8\u09c7 \u09b8\u09b0\u09cd\u09ac\u09a8\u09bf\u09ae\u09cd\u09a8 \u09b0\u09bf\u099f\u09be\u09b0\u09cd\u09a8\",\"Worst 1D\":\"\u098f\u0995 \u09a6\u09bf\u09a8\u09c7 \u09b8\u09b0\u09cd\u09ac\u09a8\u09bf\u09ae\u09cd\u09a8\",\"Worst 1D: {value}%\":\"\u098f\u0995 \u09a6\u09bf\u09a8\u09c7 \u09b8\u09b0\u09cd\u09ac\u09a8\u09bf\u09ae\u09cd\u09a8: {value}%\",\"Worst single-day return observed in the series (most negative daily return).\":\"\u09b8\u09ae\u09af\u09bc\u0995\u09cd\u09b0\u09ae\u09c7 \u098f\u0995 \u09a6\u09bf\u09a8\u09c7 \u09b8\u09b0\u09cd\u09ac\u09a8\u09bf\u09ae\u09cd\u09a8 \u09b0\u09bf\u099f\u09be\u09b0\u09cd\u09a8 (\u09b8\u09ac\u099a\u09c7\u09af\u09bc\u09c7 \u09ac\u09c7\u09b6\u09bf \u09a6\u09c8\u09a8\u09bf\u0995 \u0995\u09cd\u09b7\u09a4\u09bf)\u0964\",\"YTD\":\"\u09ac\u099b\u09b0\u09c7\u09b0 \u09b6\u09c1\u09b0\u09c1 \u09a5\u09c7\u0995\u09c7\",\"You don\\'t have any portfolio yet.\":\"\u0986\u09aa\u09a8\u09be\u09b0 \u098f\u0996\u09a8\u09cb \u0995\u09cb\u09a8\u09cb \u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993 \u09a8\u09c7\u0987\u0964\",\"cr\":\" \u0995\u09cb\u099f\u09bf\",\"k\":\" \u09b9\u09be\u099c\u09be\u09b0\",\"long\":\"\u09b2\u0982\",\"of\":\"\u098f\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7\",\"short\":\"\u09b6\u09b0\u09cd\u099f\",\"{value} Amount\":\"{value}-\u098f\u09b0 \u09aa\u09b0\u09bf\u09ae\u09be\u09a3\",\"{value} Money\":\"\u0985\u09b0\u09cd\u09a5 {value}\",\"{value} Overview\":\"{value}-\u098f\u09b0 \u09b8\u09be\u09b0\u09b8\u0982\u0995\u09cd\u09b7\u09c7\u09aa\",\"{value} Transaction\":\"{value} \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\",\"\u09f3{value}\":\"\u09f3{value}\",\"\ud83d\udcac Open WhatsApp\":\"\ud83d\udcac \u09b9\u09cb\u09af\u09bc\u09be\u099f\u09b8\u0985\u09cd\u09af\u09be\u09aa \u0996\u09c1\u09b2\u09c1\u09a8\",\"\ud83d\udccb Copy Number\":\"\ud83d\udccb \u09a8\u09ae\u09cd\u09ac\u09b0 \u0995\u09aa\u09bf \u0995\u09b0\u09c1\u09a8\"}'),w=JSON.parse('{\"App tour\":\"App tour\",\"Welcome to StockNow\":\"Welcome to StockNow\",\"Choose the language you feel at home in.\":\"Choose the language you feel at home in.\",\"Skip\":\"Skip\",\"Continue\":\"Continue\",\"Skip tour\":\"Skip tour\",\"Step {step} of {total}\":\"Step {step} of {total}\",\"You can change your language anytime from the menu.\":\"You can change your language anytime from the menu.\",\"Get to know your app\":\"Get to know your app\",\"A few useful places to start.\":\"A few useful places to start.\",\"Follow the market\":\"Follow the market\",\"Home brings together market indices, share prices and the latest news.\":\"Home brings together market indices, share prices and the latest news.\",\"Keep your favorites close\":\"Keep your favorites close\",\"Create a favorite list and add the shares you want to follow.\":\"Create a favorite list and add the shares you want to follow.\",\"Understand your portfolio\":\"Understand your portfolio\",\"Record your investments to follow your holdings and performance.\":\"Record your investments to follow your holdings and performance.\",\"Look into a share\":\"Look into a share\",\"Search for a company to see its details and charts. Use Screener to filter shares.\":\"Search for a company to see its details and charts. Use Screener to filter shares.\",\"Make it yours\":\"Make it yours\",\"What would you like to do first?\":\"What would you like to do first?\",\"Choose your first step\":\"Choose your first step\",\"Create a favorite list\":\"Create a favorite list\",\"Start with the shares you care about.\":\"Start with the shares you care about.\",\"Set up a portfolio\":\"Set up a portfolio\",\"Keep track of investments you already own.\":\"Keep track of investments you already own.\",\"Explore shares\":\"Explore shares\",\"Search the market. No account needed.\":\"Search the market. No account needed.\",\"Sign in or create a free account to save your list or portfolio. We will bring you back to this step.\":\"Sign in or create a free account to save your list or portfolio. We will bring you back to this step.\",\"You choose what to add. Nothing is created until you save it.\":\"You choose what to add. Nothing is created until you save it.\",\"Continue to sign in\":\"Continue to sign in\",\"Choose my first step\":\"Choose my first step\",\"Just look around\":\"Just look around\",\"A quick, optional tour. Go at your own pace.\":\"A quick, optional tour. Go at your own pace.\"}'),b=JSON.parse('{\"App tour\":\"\u0985\u09cd\u09af\u09be\u09aa \u09aa\u09b0\u09bf\u099a\u09bf\u09a4\u09bf\",\"Welcome to StockNow\":\"StockNow-\u09a4\u09c7 \u09b8\u09cd\u09ac\u09be\u0997\u09a4\u09ae\",\"Choose the language you feel at home in.\":\"\u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u099b\u09a8\u09cd\u09a6\u09c7\u09b0 \u09ad\u09be\u09b7\u09be \u09ac\u09c7\u099b\u09c7 \u09a8\u09bf\u09a8\u0964\",\"Skip\":\"\u098f\u09a1\u09bc\u09bf\u09af\u09bc\u09c7 \u09af\u09be\u09a8\",\"Continue\":\"\u098f\u0997\u09bf\u09af\u09bc\u09c7 \u09af\u09be\u09a8\",\"Skip tour\":\"\u09aa\u09b0\u09bf\u099a\u09bf\u09a4\u09bf \u098f\u09a1\u09bc\u09bf\u09af\u09bc\u09c7 \u09af\u09be\u09a8\",\"Step {step} of {total}\":\"{total}\u099f\u09bf \u09a7\u09be\u09aa\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u09a7\u09be\u09aa {step}\",\"You can change your language anytime from the menu.\":\"\u09ae\u09c7\u09a8\u09c1 \u09a5\u09c7\u0995\u09c7 \u09af\u09c7\u0995\u09cb\u09a8\u09cb \u09b8\u09ae\u09af\u09bc \u09ad\u09be\u09b7\u09be \u09ac\u09a6\u09b2\u09be\u09a4\u09c7 \u09aa\u09be\u09b0\u09ac\u09c7\u09a8\u0964\",\"Get to know your app\":\"\u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf \u099a\u09bf\u09a8\u09c7 \u09a8\u09bf\u09a8\",\"A few useful places to start.\":\"\u09b6\u09c1\u09b0\u09c1\u09a4\u09c7 \u0995\u09be\u099c\u09c7 \u09b2\u09be\u0997\u09ac\u09c7 \u098f\u09ae\u09a8 \u0995\u09bf\u099b\u09c1 \u09ab\u09bf\u099a\u09be\u09b0\u0964\",\"Follow the market\":\"\u09ac\u09be\u099c\u09be\u09b0\u09c7\u09b0 \u0996\u09cb\u0981\u099c \u09b0\u09be\u0996\u09c1\u09a8\",\"Home brings together market indices, share prices and the latest news.\":\"\u09b9\u09cb\u09ae\u09c7 \u098f\u0995\u09b8\u0999\u09cd\u0997\u09c7 \u09aa\u09be\u09ac\u09c7\u09a8 \u09ac\u09be\u099c\u09be\u09b0\u09c7\u09b0 \u09b8\u09c2\u099a\u0995, \u09b6\u09c7\u09af\u09bc\u09be\u09b0\u09c7\u09b0 \u09a6\u09be\u09ae \u0993 \u09b8\u09b0\u09cd\u09ac\u09b6\u09c7\u09b7 \u0996\u09ac\u09b0\u0964\",\"Keep your favorites close\":\"\u09aa\u099b\u09a8\u09cd\u09a6\u09c7\u09b0 \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u098f\u0995 \u099c\u09be\u09af\u09bc\u0997\u09be\u09af\u09bc\",\"Create a favorite list and add the shares you want to follow.\":\"\u098f\u0995\u099f\u09bf \u09aa\u099b\u09a8\u09cd\u09a6\u09c7\u09b0 \u09a4\u09be\u09b2\u09bf\u0995\u09be \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09c7 \u09af\u09c7\u09b8\u09ac \u09b6\u09c7\u09af\u09bc\u09be\u09b0\u09c7\u09b0 \u0996\u09cb\u0981\u099c \u09b0\u09be\u0996\u09a4\u09c7 \u099a\u09be\u09a8, \u09b8\u09c7\u0997\u09c1\u09b2\u09cb \u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\u0964\",\"Understand your portfolio\":\"\u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993\u09b0 \u0985\u09ac\u09b8\u09cd\u09a5\u09be \u099c\u09be\u09a8\u09c1\u09a8\",\"Record your investments to follow your holdings and performance.\":\"\u0986\u09aa\u09a8\u09be\u09b0 \u09ac\u09bf\u09a8\u09bf\u09af\u09bc\u09cb\u0997\u09c7\u09b0 \u09b9\u09bf\u09b8\u09be\u09ac \u09b0\u09be\u0996\u09c1\u09a8\u0964 \u0995\u09c0 \u0995\u09c0 \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u0986\u099b\u09c7 \u0993 \u09b2\u09be\u09ad-\u0995\u09cd\u09b7\u09a4\u09bf\u09b0 \u0985\u09ac\u09b8\u09cd\u09a5\u09be \u09a6\u09c7\u0996\u09c1\u09a8\u0964\",\"Look into a share\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0\u09c7\u09b0 \u09ac\u09bf\u09b8\u09cd\u09a4\u09be\u09b0\u09bf\u09a4 \u09a6\u09c7\u0996\u09c1\u09a8\",\"Search for a company to see its details and charts. Use Screener to filter shares.\":\"\u0995\u09cb\u09ae\u09cd\u09aa\u09be\u09a8\u09bf \u0996\u09c1\u0981\u099c\u09c7 \u09a4\u09be\u09b0 \u09ac\u09bf\u09b8\u09cd\u09a4\u09be\u09b0\u09bf\u09a4 \u09a4\u09a5\u09cd\u09af \u0993 \u099a\u09be\u09b0\u09cd\u099f \u09a6\u09c7\u0996\u09c1\u09a8\u0964 \u09b6\u09b0\u09cd\u09a4 \u0985\u09a8\u09c1\u09af\u09be\u09af\u09bc\u09c0 \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09ac\u09be\u099b\u09be\u0987 \u0995\u09b0\u09a4\u09c7 \u09b8\u09cd\u0995\u09cd\u09b0\u09bf\u09a8\u09be\u09b0 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c1\u09a8\u0964\",\"Make it yours\":\"\u09a8\u09bf\u099c\u09c7\u09b0 \u09ae\u09a4\u09cb \u0995\u09b0\u09c7 \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09c1\u09a8\",\"What would you like to do first?\":\"\u09aa\u09cd\u09b0\u09a5\u09ae\u09c7 \u0995\u09c0 \u0995\u09b0\u09a4\u09c7 \u099a\u09be\u09a8?\",\"Choose your first step\":\"\u09aa\u09cd\u09b0\u09a5\u09ae\u09c7 \u0995\u09c0 \u0995\u09b0\u09ac\u09c7\u09a8 \u09ac\u09c7\u099b\u09c7 \u09a8\u09bf\u09a8\",\"Create a favorite list\":\"\u09aa\u099b\u09a8\u09cd\u09a6\u09c7\u09b0 \u09a4\u09be\u09b2\u09bf\u0995\u09be \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09c1\u09a8\",\"Start with the shares you care about.\":\"\u0986\u09aa\u09a8\u09be\u09b0 \u0986\u0997\u09cd\u09b0\u09b9\u09c7\u09b0 \u09b6\u09c7\u09af\u09bc\u09be\u09b0\u0997\u09c1\u09b2\u09cb \u09a6\u09bf\u09af\u09bc\u09c7 \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09c1\u09a8\u0964\",\"Set up a portfolio\":\"\u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993 \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09c1\u09a8\",\"Keep track of investments you already own.\":\"\u0986\u09aa\u09a8\u09be\u09b0 \u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8 \u09ac\u09bf\u09a8\u09bf\u09af\u09bc\u09cb\u0997\u09c7\u09b0 \u09b9\u09bf\u09b8\u09be\u09ac \u09b0\u09be\u0996\u09c1\u09a8\u0964\",\"Explore shares\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u0996\u09c1\u0981\u099c\u09c7 \u09a6\u09c7\u0996\u09c1\u09a8\",\"Search the market. No account needed.\":\"\u09ac\u09be\u099c\u09be\u09b0\u09c7\u09b0 \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u0996\u09c1\u0981\u099c\u09c7 \u09a6\u09c7\u0996\u09c1\u09a8\u0964 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u09b2\u09be\u0997\u09ac\u09c7 \u09a8\u09be\u0964\",\"Sign in or create a free account to save your list or portfolio. We will bring you back to this step.\":\"\u09a4\u09be\u09b2\u09bf\u0995\u09be \u09ac\u09be \u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993 \u09b8\u0982\u09b0\u0995\u09cd\u09b7\u09a3 \u0995\u09b0\u09a4\u09c7 \u09b2\u0997\u0987\u09a8 \u0995\u09b0\u09c1\u09a8 \u0985\u09a5\u09ac\u09be \u09ac\u09bf\u09a8\u09be\u09ae\u09c2\u09b2\u09cd\u09af\u09c7 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09c1\u09a8\u0964 \u098f\u09b0\u09aa\u09b0 \u098f\u0996\u09be\u09a8 \u09a5\u09c7\u0995\u09c7\u0987 \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09ac\u09c7\u09a8\u0964\",\"You choose what to add. Nothing is created until you save it.\":\"\u0995\u09c0 \u09af\u09cb\u0997 \u0995\u09b0\u09ac\u09c7\u09a8 \u09a4\u09be \u0986\u09aa\u09a8\u09bf\u0987 \u09ac\u09c7\u099b\u09c7 \u09a8\u09c7\u09ac\u09c7\u09a8\u0964 \u09b8\u0982\u09b0\u0995\u09cd\u09b7\u09a3 \u09a8\u09be \u0995\u09b0\u09be \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u0995\u09bf\u099b\u09c1 \u09a4\u09c8\u09b0\u09bf \u09b9\u09ac\u09c7 \u09a8\u09be\u0964\",\"Continue to sign in\":\"\u09b2\u0997\u0987\u09a8 \u0995\u09b0\u09a4\u09c7 \u098f\u0997\u09bf\u09af\u09bc\u09c7 \u09af\u09be\u09a8\",\"Choose my first step\":\"\u09aa\u09cd\u09b0\u09a5\u09ae\u09c7 \u0995\u09c0 \u0995\u09b0\u09ac \u09ac\u09c7\u099b\u09c7 \u09a8\u09bf\u0987\",\"Just look around\":\"\u0986\u09aa\u09be\u09a4\u09a4 \u0998\u09c1\u09b0\u09c7 \u09a6\u09c7\u0996\u09bf\",\"A quick, optional tour. Go at your own pace.\":\"\u09b8\u0982\u0995\u09cd\u09b7\u09bf\u09aa\u09cd\u09a4 \u098f\u0987 \u09aa\u09b0\u09bf\u099a\u09bf\u09a4\u09bf \u09a6\u09c7\u0996\u09be \u0990\u099a\u09cd\u099b\u09bf\u0995\u0964 \u09a8\u09bf\u099c\u09c7\u09b0 \u09b8\u09ae\u09af\u09bc \u09a8\u09bf\u09af\u09bc\u09c7 \u09a6\u09c7\u0996\u09c1\u09a8\u0964\"}'),S=\"stocknow.language\",k=Object.