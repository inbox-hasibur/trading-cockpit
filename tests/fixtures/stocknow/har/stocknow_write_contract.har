,\"25%\":\"\u09e8\u09eb%\",\"3M\":\"\u09e9 \u09ae\u09be\u09b8\",\"50%\":\"\u09eb\u09e6%\",\"6M\":\"\u09ec \u09ae\u09be\u09b8\",\"75%\":\"\u09ed\u09eb%\",\"ADD\":\"\u09af\u09cb\u0997\",\"ATR(14)\":\"\u098f\u099f\u09bf\u0986\u09b0 (\u09e7\u09ea)\",\"ATR(14): {value}%\":\"\u098f\u099f\u09bf\u0986\u09b0 (\u09e7\u09ea): {value}%\",\"AVG/Group\":\"\u0997\u09a1\u09bc/\u0997\u09cd\u09b0\u09c1\u09aa\",\"Abs Return\":\"\u09ae\u09cb\u099f \u09b0\u09bf\u099f\u09be\u09b0\u09cd\u09a8\",\"Actions\":\"\u0995\u09b0\u09a3\u09c0\u09af\u09bc\",\"Actions for {value}\":\"{value}-\u098f\u09b0 \u099c\u09a8\u09cd\u09af \u0995\u09b0\u09a3\u09c0\u09af\u09bc\",\"Add\":\"\u09af\u09cb\u0997\",\"Add Another Stock\":\"\u0986\u09b0\u09c7\u0995\u099f\u09bf \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\",\"Add Share\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\",\"Add more item\":\"\u0986\u09b0\u0993 \u0986\u0987\u099f\u09c7\u09ae \u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\",\"Adding Stocks...\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09af\u09cb\u0997 \u0995\u09b0\u09be \u09b9\u099a\u09cd\u099b\u09c7...\",\"Adding...\":\"\u09af\u09cb\u0997 \u0995\u09b0\u09be \u09b9\u099a\u09cd\u099b\u09c7...\",\"All\":\"\u09b8\u09ac\",\"Amount\":\"\u099f\u09be\u0995\u09be\u09b0 \u09aa\u09b0\u09bf\u09ae\u09be\u09a3\",\"Annualized %\":\"\u09ac\u09be\u09b0\u09cd\u09b7\u09bf\u0995 \u09b9\u09bf\u09b8\u09be\u09ac\u09c7 %\",\"Annualized volatility: the standard deviation of portfolio returns scaled to 1 year. Higher % means larger typical swings in portfolio value.\":\"\u09ac\u09be\u09b0\u09cd\u09b7\u09bf\u0995 \u0985\u09b8\u09cd\u09a5\u09bf\u09b0\u09a4\u09be: \u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993\u09b0 \u09b0\u09bf\u099f\u09be\u09b0\u09cd\u09a8\u09c7\u09b0 \u09ae\u09be\u09a8\u0995 \u09ac\u09bf\u099a\u09cd\u09af\u09c1\u09a4\u09bf \u098f\u0995 \u09ac\u099b\u09b0\u09c7\u09b0 \u09b9\u09bf\u09b8\u09be\u09ac\u09c7 \u09aa\u09cd\u09b0\u0995\u09be\u09b6 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u0964 \u09b6\u09a4\u09be\u0982\u09b6 \u09ac\u09c7\u09b6\u09bf \u09b9\u09b2\u09c7 \u09b8\u09be\u09a7\u09be\u09b0\u09a3\u09a4 \u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993\u09b0 \u09ae\u09c2\u09b2\u09cd\u09af\u09c7 \u09ac\u09c7\u09b6\u09bf \u0993\u09a0\u09be\u09a8\u09be\u09ae\u09be \u09b9\u09af\u09bc\u0964\",\"Are you sure you want to delete this portfolio? This action cannot be undone.\":\"\u0986\u09aa\u09a8\u09bf \u0995\u09bf \u098f\u0987 \u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993 \u09ae\u09c1\u099b\u09c7 \u09ab\u09c7\u09b2\u09a4\u09c7 \u099a\u09be\u09a8? \u098f\u099f\u09bf \u0986\u09b0 \u09ab\u09bf\u09b0\u09bf\u09af\u09bc\u09c7 \u0986\u09a8\u09be \u09af\u09be\u09ac\u09c7 \u09a8\u09be\u0964\",\"Are you sure?\":\"\u0986\u09aa\u09a8\u09bf \u0995\u09bf \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4?\",\"As of {value}\":\"{value} \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4\",\"As-Of Snapshot\":\"\u09a8\u09bf\u09b0\u09cd\u09a6\u09bf\u09b7\u09cd\u099f \u09a4\u09be\u09b0\u09bf\u0996\u09c7\u09b0 \u099a\u09bf\u09a4\u09cd\u09b0\",\"Auto (qty \u00d7 price)\":\"\u09b8\u09cd\u09ac\u09af\u09bc\u0982\u0995\u09cd\u09b0\u09bf\u09af\u09bc (\u09aa\u09b0\u09bf\u09ae\u09be\u09a3 \u00d7 \u09a6\u09be\u09ae)\",\"Average True Range (14): measures volatility by averaging true ranges (based on high/low/previous close). Expressed as % of last close.\":\"\u098f\u09ad\u09be\u09b0\u09c7\u099c \u099f\u09cd\u09b0\u09c1 \u09b0\u09c7\u099e\u09cd\u099c (\u09e7\u09ea): \u09b9\u09be\u0987, \u09b2\u09cb \u0993 \u0986\u0997\u09c7\u09b0 \u0995\u09cd\u09b2\u09cb\u099c\u09bf\u0982 \u09aa\u09cd\u09b0\u09be\u0987\u09b8\u09c7\u09b0 \u09ad\u09bf\u09a4\u09cd\u09a4\u09bf\u09a4\u09c7 \u099f\u09cd\u09b0\u09c1 \u09b0\u09c7\u099e\u09cd\u099c\u09c7\u09b0 \u0997\u09a1\u09bc \u09a6\u09bf\u09af\u09bc\u09c7 \u09ad\u09cb\u09b2\u09be\u099f\u09bf\u09b2\u09bf\u099f\u09bf \u09ae\u09be\u09aa\u09be \u09b9\u09af\u09bc\u0964 \u09b8\u09b0\u09cd\u09ac\u09b6\u09c7\u09b7 \u0995\u09cd\u09b2\u09cb\u099c\u09bf\u0982 \u09aa\u09cd\u09b0\u09be\u0987\u09b8\u09c7\u09b0 \u09b6\u09a4\u09be\u0982\u09b6 \u09b9\u09bf\u09b8\u09c7\u09ac\u09c7 \u09a6\u09c7\u0996\u09be\u09a8\u09cb \u09b9\u09af\u09bc\u0964\",\"Average True Range (14-day)\":\"\u098f\u09ad\u09be\u09b0\u09c7\u099c \u099f\u09cd\u09b0\u09c1 \u09b0\u09c7\u099e\u09cd\u099c (\u09e7\u09ea \u09a6\u09bf\u09a8)\",\"Average daily return over the lookback window. This is a simple average of daily returns (not guaranteed future performance).\":\"\u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09bf\u09a4 \u09b8\u09ae\u09af\u09bc\u09c7\u09b0 \u09a6\u09c8\u09a8\u09bf\u0995 \u09b0\u09bf\u099f\u09be\u09b0\u09cd\u09a8\u09c7\u09b0 \u09b8\u09be\u09a7\u09be\u09b0\u09a3 \u0997\u09a1\u09bc\u0964 \u098f\u099f\u09bf \u09ad\u09ac\u09bf\u09b7\u09cd\u09af\u09a4\u09c7\u09b0 \u09ab\u09b2\u09be\u09ab\u09b2\u09c7\u09b0 \u09a8\u09bf\u09b6\u09cd\u099a\u09af\u09bc\u09a4\u09be \u09a6\u09c7\u09af\u09bc \u09a8\u09be\u0964\",\"Avg\":\"\u0997\u09a1\u09bc\",\"Avg Cost\":\"\u0997\u09a1\u09bc \u0995\u09cd\u09b0\u09af\u09bc\u09ae\u09c2\u09b2\u09cd\u09af\",\"Avg Daily Return\":\"\u0997\u09a1\u09bc \u09a6\u09c8\u09a8\u09bf\u0995 \u09b0\u09bf\u099f\u09be\u09b0\u09cd\u09a8\",\"BONUS\":\"\u09ac\u09cb\u09a8\u09be\u09b8\",\"BUY\":\"\u0995\u09cd\u09b0\u09af\u09bc\",\"Back\":\"\u09ab\u09bf\u09b0\u09c1\u09a8\",\"Back/All Portfolios\":\"\u09ab\u09bf\u09b0\u09c1\u09a8/\u09b8\u09ac \u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993\",\"Balance\":\"\u09ac\u09cd\u09af\u09be\u09b2\u09c7\u09a8\u09cd\u09b8\",\"Balance(Tk)\":\"\u09ac\u09cd\u09af\u09be\u09b2\u09c7\u09a8\u09cd\u09b8 (\u099f\u09be\u0995\u09be)\",\"Base\":\"\u09ad\u09bf\u09a4\u09cd\u09a4\u09bf\",\"Based on current price\":\"\u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8 \u09a6\u09be\u09ae\u09c7\u09b0 \u09ad\u09bf\u09a4\u09cd\u09a4\u09bf\u09a4\u09c7\",\"Benchmark Corr\":\"\u09ac\u09c7\u099e\u09cd\u099a\u09ae\u09be\u09b0\u09cd\u0995\u09c7\u09b0 \u09b8\u0999\u09cd\u0997\u09c7 \u09b8\u09b9\u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\",\"Best\":\"\u09b8\u09c7\u09b0\u09be\",\"Best / Worst\":\"\u09b8\u09c7\u09b0\u09be / \u09b8\u09b0\u09cd\u09ac\u09a8\u09bf\u09ae\u09cd\u09a8\",\"Beta\":\"\u09ac\u09bf\u099f\u09be\",\"Beta vs the benchmark: sensitivity to benchmark moves. 1.0 means move similar to benchmark; >1 more sensitive; <1 less sensitive; negative moves opposite.\":\"\u09ac\u09c7\u099e\u09cd\u099a\u09ae\u09be\u09b0\u09cd\u0995\u09c7\u09b0 \u09a4\u09c1\u09b2\u09a8\u09be\u09af\u09bc \u09ac\u09bf\u099f\u09be: \u09ac\u09c7\u099e\u09cd\u099a\u09ae\u09be\u09b0\u09cd\u0995\u09c7\u09b0 \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf \u09b8\u0982\u09ac\u09c7\u09a6\u09a8\u09b6\u09c0\u09b2\u09a4\u09be\u0964 \u09e7.\u09e6 \u09ae\u09be\u09a8\u09c7 \u098f\u0995\u0987 \u09b0\u0995\u09ae \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8; \u09e7-\u098f\u09b0 \u09ac\u09c7\u09b6\u09bf \u09ae\u09be\u09a8\u09c7 \u09ac\u09c7\u09b6\u09bf \u09b8\u0982\u09ac\u09c7\u09a6\u09a8\u09b6\u09c0\u09b2; \u09e7-\u098f\u09b0 \u0995\u09ae \u09ae\u09be\u09a8\u09c7 \u0995\u09ae \u09b8\u0982\u09ac\u09c7\u09a6\u09a8\u09b6\u09c0\u09b2; \u098b\u09a3\u09be\u09a4\u09cd\u09ae\u0995 \u09ae\u09be\u09a8\u09c7 \u09ac\u09bf\u09aa\u09b0\u09c0\u09a4 \u09a6\u09bf\u0995\u09c7 \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8\u0964\",\"Bonus\":\"\u09ac\u09cb\u09a8\u09be\u09b8\",\"Bonus (Share)\":\"\u09ac\u09cb\u09a8\u09be\u09b8 (\u09b6\u09c7\u09af\u09bc\u09be\u09b0)\",\"Broker Commission (%)\":\"\u09ac\u09cd\u09b0\u09cb\u0995\u09be\u09b0 \u0995\u09ae\u09bf\u09b6\u09a8 (%)\",\"Broker Name\":\"\u09ac\u09cd\u09b0\u09cb\u0995\u09be\u09b0\u09c7\u09b0 \u09a8\u09be\u09ae\",\"Broker:\":\"\u09ac\u09cd\u09b0\u09cb\u0995\u09be\u09b0:\",\"Buy\":\"\u0995\u09cd\u09b0\u09af\u09bc\",\"Buy More\":\"\u0986\u09b0\u0993 \u0995\u09bf\u09a8\u09c1\u09a8\",\"Buy Price\":\"\u0995\u09cd\u09b0\u09af\u09bc\u09ae\u09c2\u09b2\u09cd\u09af\",\"Buy Share\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u0995\u09bf\u09a8\u09c1\u09a8\",\"Buy Shares\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u0995\u09bf\u09a8\u09c1\u09a8\",\"CSE\":\"CSE\",\"CVaR ({value})\":\"\u09b8\u09bf\u09ad\u09bf\u098f\u0986\u09b0 ({value})\",\"Calculating\u2026\":\"\u09b9\u09bf\u09b8\u09be\u09ac \u0995\u09b0\u09be \u09b9\u099a\u09cd\u099b\u09c7\u2026\",\"Cancel\":\"\u09ac\u09be\u09a4\u09bf\u09b2\",\"Cards\":\"\u0995\u09be\u09b0\u09cd\u09a1\",\"Cash\":\"\u09a8\u0997\u09a6\",\"Cash Amount (BDT)\":\"\u09a8\u0997\u09a6 \u0985\u09b0\u09cd\u09a5 (\u099f\u09be\u0995\u09be)\",\"Cash Amount(Tk)\":\"\u09a8\u0997\u09a6 \u0985\u09b0\u09cd\u09a5 (\u099f\u09be\u0995\u09be)\",\"Cash Balance\":\"\u09a8\u0997\u09a6 \u09ac\u09cd\u09af\u09be\u09b2\u09c7\u09a8\u09cd\u09b8\",\"Cash {value}/-\":\"\u09a8\u0997\u09a6 {value}/-\",\"Change: {value} ({value2}%)\":\"\u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8: {value} ({value2}%)\",\"Classic\":\"\u0995\u09cd\u09b2\u09be\u09b8\u09bf\u0995\",\"Close\":\"\u09ac\u09a8\u09cd\u09a7 \u0995\u09b0\u09c1\u09a8\",\"Comission(%)\":\"\u0995\u09ae\u09bf\u09b6\u09a8 (%)\",\"Comm(Tk)\":\"\u0995\u09ae\u09bf\u09b6\u09a8 (\u099f\u09be\u0995\u09be)\",\"Commission {value}\":\"\u0995\u09ae\u09bf\u09b6\u09a8 {value}\",\"Commission(%)\":\"\u0995\u09ae\u09bf\u09b6\u09a8 (%)\",\"Commission:\":\"\u0995\u09ae\u09bf\u09b6\u09a8:\",\"Company\":\"\u0995\u09cb\u09ae\u09cd\u09aa\u09be\u09a8\u09bf\",\"Conditional VaR (CVaR): the average loss on the worst days beyond VaR. Typically larger (more conservative) than VaR.\":\"\u0995\u09a8\u09cd\u09a1\u09bf\u09b6\u09a8\u09be\u09b2 \u09ad\u09bf\u098f\u0986\u09b0 (\u09b8\u09bf\u09ad\u09bf\u098f\u0986\u09b0): \u09ad\u09bf\u098f\u0986\u09b0 \u09b8\u09c0\u09ae\u09be \u099b\u09be\u09a1\u09bc\u09bf\u09af\u09bc\u09c7 \u09af\u09be\u0993\u09af\u09bc\u09be \u09b8\u09ac\u099a\u09c7\u09af\u09bc\u09c7 \u0996\u09be\u09b0\u09be\u09aa \u09a6\u09bf\u09a8\u0997\u09c1\u09b2\u09cb\u09b0 \u0997\u09a1\u09bc \u0995\u09cd\u09b7\u09a4\u09bf\u0964 \u09b8\u09be\u09a7\u09be\u09b0\u09a3\u09a4 \u098f\u099f\u09bf \u09ad\u09bf\u098f\u0986\u09b0\u09c7\u09b0 \u099a\u09c7\u09af\u09bc\u09c7 \u09ac\u09c7\u09b6\u09bf \u09b8\u09a4\u09b0\u09cd\u0995 \u0985\u09a8\u09c1\u09ae\u09be\u09a8\u0964\",\"Confirm\":\"\u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u09c1\u09a8\",\"Confirm {value}\":\"{value} \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u09c1\u09a8\",\"Contributors\":\"\u09b2\u09be\u09ad\u09c7 \u0985\u09ac\u09a6\u09be\u09a8\u0995\u09be\u09b0\u09c0\",\"Correlation Instruments\":\"\u09b8\u09b9\u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7\u09b0 \u0985\u09a8\u09cd\u09a4\u09b0\u09cd\u09ad\u09c1\u0995\u09cd\u09a4 \u09b6\u09c7\u09af\u09bc\u09be\u09b0\",\"Correlation data not available.\":\"\u09b8\u09b9\u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7\u09b0 \u09a4\u09a5\u09cd\u09af \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\u0964\",\"Correlation of this instrument\u2019s returns with the base instrument (range -1 to +1).\":\"\u098f\u0987 \u09b6\u09c7\u09af\u09bc\u09be\u09b0\u09c7\u09b0 \u09b0\u09bf\u099f\u09be\u09b0\u09cd\u09a8\u09c7\u09b0 \u09b8\u0999\u09cd\u0997\u09c7 \u09ad\u09bf\u09a4\u09cd\u09a4\u09bf \u09b6\u09c7\u09af\u09bc\u09be\u09b0\u09c7\u09b0 \u09b0\u09bf\u099f\u09be\u09b0\u09cd\u09a8\u09c7\u09b0 \u09b8\u09b9\u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995 (\u09b8\u09c0\u09ae\u09be \u2212\u09e7 \u09a5\u09c7\u0995\u09c7 +\u09e7)\u0964\",\"Correlation with the benchmark: ranges from -1 to +1. +1 moves together, 0 no linear relationship, -1 moves opposite.\":\"\u09ac\u09c7\u099e\u09cd\u099a\u09ae\u09be\u09b0\u09cd\u0995\u09c7\u09b0 \u09b8\u0999\u09cd\u0997\u09c7 \u09b8\u09b9\u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995: \u09b8\u09c0\u09ae\u09be \u2212\u09e7 \u09a5\u09c7\u0995\u09c7 +\u09e7\u0964 +\u09e7 \u09ae\u09be\u09a8\u09c7 \u098f\u0995\u0987 \u09a6\u09bf\u0995\u09c7 \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8, \u09e6 \u09ae\u09be\u09a8\u09c7 \u09b8\u09b0\u09b2\u09b0\u09c8\u0996\u09bf\u0995 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995 \u09a8\u09c7\u0987, \u2212\u09e7 \u09ae\u09be\u09a8\u09c7 \u09ac\u09bf\u09aa\u09b0\u09c0\u09a4 \u09a6\u09bf\u0995\u09c7 \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8\u0964\",\"Correlations\":\"\u09b8\u09b9\u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\",\"Cost:\":\"\u0995\u09cd\u09b0\u09af\u09bc\u09ae\u09c2\u09b2\u09cd\u09af:\",\"Create New Portfolio\":\"\u09a8\u09a4\u09c1\u09a8 \u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993 \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09c1\u09a8\",\"Create Portfolio\":\"\u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993 \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09c1\u09a8\",\"Create Portfolio & Add Stocks\":\"\u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993 \u09a4\u09c8\u09b0\u09bf \u0993 \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\",\"Create Portfolio (Add Stocks)\":\"\u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993 \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09c1\u09a8 (\u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09af\u09cb\u0997)\",\"Create a portfolio to track holdings, cash balance, and gain/loss in one place.\":\"\u098f\u0995 \u099c\u09be\u09af\u09bc\u0997\u09be\u09af\u09bc \u09b6\u09c7\u09af\u09bc\u09be\u09b0, \u09a8\u0997\u09a6 \u09ac\u09cd\u09af\u09be\u09b2\u09c7\u09a8\u09cd\u09b8 \u0993 \u09b2\u09be\u09ad/\u0995\u09cd\u09b7\u09a4\u09bf \u09a6\u09c7\u0996\u09a4\u09c7 \u098f\u0995\u099f\u09bf \u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993 \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09c1\u09a8\u0964\",\"Created:\":\"\u09a4\u09c8\u09b0\u09bf\u09b0 \u09b8\u09ae\u09af\u09bc:\",\"Creating Portfolio...\":\"\u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993 \u09a4\u09c8\u09b0\u09bf \u09b9\u099a\u09cd\u099b\u09c7...\",\"Creating portfolio...\":\"\u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993 \u09a4\u09c8\u09b0\u09bf \u09b9\u099a\u09cd\u099b\u09c7...\",\"Currency:\":\"\u09ae\u09c1\u09a6\u09cd\u09b0\u09be:\",\"DELETE\":\"\u09ae\u09c1\u099b\u09c1\u09a8\",\"DELETE DATE\":\"\u09ae\u09c1\u099b\u09c7 \u09ab\u09c7\u09b2\u09be\u09b0 \u09a4\u09be\u09b0\u09bf\u0996\",\"DEPOSIT\":\"\u099c\u09ae\u09be\",\"DIVIDEND\":\"\u09b2\u09ad\u09cd\u09af\u09be\u0982\u09b6\",\"DSEX\":\"DSEX\",\"Date\":\"\u09a4\u09be\u09b0\u09bf\u0996\",\"Date & Time\":\"\u09a4\u09be\u09b0\u09bf\u0996 \u0993 \u09b8\u09ae\u09af\u09bc\",\"Date:\":\"\u09a4\u09be\u09b0\u09bf\u0996:\",\"Debit/Credit(Tk)\":\"\u09a1\u09c7\u09ac\u09bf\u099f/\u0995\u09cd\u09b0\u09c7\u09a1\u09bf\u099f (\u099f\u09be\u0995\u09be)\",\"Default\":\"\u09a1\u09bf\u09ab\u09b2\u09cd\u099f\",\"Delete\":\"\u09ae\u09c1\u099b\u09c1\u09a8\",\"Delete Failed: {value}\":\"\u09ae\u09c1\u099b\u09c7 \u09ab\u09c7\u09b2\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf: {value}\",\"Delete Portfolio?\":\"\u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993 \u09ae\u09c1\u099b\u09c7 \u09ab\u09c7\u09b2\u09ac\u09c7\u09a8?\",\"Delete Share\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09ae\u09c1\u099b\u09c1\u09a8\",\"Deleting all shares in this portfolio. Are you sure?\":\"\u098f\u0987 \u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993\u09b0 \u09b8\u09ac \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09ae\u09c1\u099b\u09c7 \u09ab\u09c7\u09b2\u09be \u09b9\u09ac\u09c7\u0964 \u0986\u09aa\u09a8\u09bf \u0995\u09bf \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4?\",\"Deleting...\":\"\u09ae\u09c1\u099b\u09c7 \u09ab\u09c7\u09b2\u09be \u09b9\u099a\u09cd\u099b\u09c7...\",\"Deposit\":\"\u099c\u09ae\u09be\",\"Deposits\":\"\u099c\u09ae\u09be\u0995\u09c3\u09a4 \u0985\u09b0\u09cd\u09a5\",\"Description\":\"\u09ac\u09bf\u09ac\u09b0\u09a3\",\"Detractors\":\"\u0995\u09cd\u09b7\u09a4\u09bf\u09a4\u09c7 \u0985\u09ac\u09a6\u09be\u09a8\u0995\u09be\u09b0\u09c0\",\"Dividend\":\"\u09b2\u09ad\u09cd\u09af\u09be\u0982\u09b6\",\"Dividend (Cash)\":\"\u09b2\u09ad\u09cd\u09af\u09be\u0982\u09b6 (\u09a8\u0997\u09a6)\",\"Dividend Cash\":\"\u09a8\u0997\u09a6 \u09b2\u09ad\u09cd\u09af\u09be\u0982\u09b6\",\"Dividend Share\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09b2\u09ad\u09cd\u09af\u09be\u0982\u09b6\",\"Dividends (cash): {value}\":\"\u09b2\u09ad\u09cd\u09af\u09be\u0982\u09b6 (\u09a8\u0997\u09a6): {value}\",\"Download PDF\":\"\u09aa\u09bf\u09a1\u09bf\u098f\u09ab \u09a1\u09be\u0989\u09a8\u09b2\u09cb\u09a1 \u0995\u09b0\u09c1\u09a8\",\"Drawdown Equity\":\"\u09aa\u09a4\u09a8\u09c7\u09b0 \u09b8\u09ae\u09af\u09bc \u09b8\u09ae\u09cd\u09aa\u09a6\u09ae\u09c2\u09b2\u09cd\u09af\",\"EDIT\":\"\u09b8\u09ae\u09cd\u09aa\u09be\u09a6\u09a8\u09be\",\"Edit\":\"\u09b8\u09ae\u09cd\u09aa\u09be\u09a6\u09a8\u09be\",\"Edit Holding\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0\u09c7\u09b0 \u09a4\u09a5\u09cd\u09af \u09b8\u09ae\u09cd\u09aa\u09be\u09a6\u09a8\u09be\",\"End Value\":\"\u09b6\u09c7\u09b7\u09c7\u09b0 \u09ae\u09c2\u09b2\u09cd\u09af\",\"End: {value}\":\"\u09b6\u09c7\u09b7: {value}\",\"Enter 0 if you don\\'t want add broker commission.\":\"\u09ac\u09cd\u09b0\u09cb\u0995\u09be\u09b0 \u0995\u09ae\u09bf\u09b6\u09a8 \u09af\u09cb\u0997 \u0995\u09b0\u09a4\u09c7 \u09a8\u09be \u099a\u09be\u0987\u09b2\u09c7 \u09e6 \u09b2\u09bf\u0996\u09c1\u09a8\u0964\",\"Enter Broker Commission\":\"\u09ac\u09cd\u09b0\u09cb\u0995\u09be\u09b0 \u0995\u09ae\u09bf\u09b6\u09a8 \u09b2\u09bf\u0996\u09c1\u09a8\",\"Enter Cash Amount\":\"\u09a8\u0997\u09a6 \u0985\u09b0\u09cd\u09a5\u09c7\u09b0 \u09aa\u09b0\u09bf\u09ae\u09be\u09a3 \u09b2\u09bf\u0996\u09c1\u09a8\",\"Enter Code (e.g. GP)\":\"\u0995\u09cb\u09a1 \u09b2\u09bf\u0996\u09c1\u09a8 (\u09af\u09c7\u09ae\u09a8 GP)\",\"Entry price\":\"\u09aa\u09cd\u09b0\u09ac\u09c7\u09b6\u09ae\u09c2\u09b2\u09cd\u09af\",\"Equity\":\"\u09ae\u09cb\u099f \u09b8\u09ae\u09cd\u09aa\u09a6\",\"Equity Curve\":\"\u09b8\u09ae\u09cd\u09aa\u09a6\u09ae\u09c2\u09b2\u09cd\u09af\u09c7\u09b0 \u09b0\u09c7\u0996\u09be\u099a\u09bf\u09a4\u09cd\u09b0\",\"Error\":\"\u09a4\u09cd\u09b0\u09c1\u099f\u09bf\",\"Error: {value}\":\"\u09a4\u09cd\u09b0\u09c1\u099f\u09bf: {value}\",\"Estimated\":\"\u0986\u09a8\u09c1\u09ae\u09be\u09a8\u09bf\u0995\",\"Exposures\":\"\u09ac\u09bf\u09a8\u09bf\u09af\u09bc\u09cb\u0997\u09c7\u09b0 \u09ac\u09bf\u09b8\u09cd\u09a4\u09be\u09b0\",\"Failed to compute performance\":\"\u09ac\u09bf\u09a8\u09bf\u09af\u09bc\u09cb\u0997\u09c7\u09b0 \u09ab\u09b2\u09be\u09ab\u09b2 \u09b9\u09bf\u09b8\u09be\u09ac \u0995\u09b0\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\",\"Failed to compute risk metrics.\":\"\u099d\u09c1\u0981\u0995\u09bf\u09b0 \u09aa\u09b0\u09bf\u09ae\u09be\u09aa \u09b9\u09bf\u09b8\u09be\u09ac \u0995\u09b0\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\u0964\",\"Failed to copy portfolio.\":\"\u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993 \u0995\u09aa\u09bf \u0995\u09b0\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\u0964\",\"Failed to delete portfolio\":\"\u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993 \u09ae\u09c1\u099b\u09c7 \u09ab\u09c7\u09b2\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\",\"Failed to generate PDF\":\"\u09aa\u09bf\u09a1\u09bf\u098f\u09ab \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\",\"Failed to load performance data\":\"\u09ac\u09bf\u09a8\u09bf\u09af\u09bc\u09cb\u0997\u09c7\u09b0 \u09ab\u09b2\u09be\u09ab\u09b2\u09c7\u09b0 \u09a4\u09a5\u09cd\u09af \u09b2\u09cb\u09a1 \u0995\u09b0\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\",\"Failed to load portfolio data\":\"\u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993\u09b0 \u09a4\u09a5\u09cd\u09af \u09b2\u09cb\u09a1 \u0995\u09b0\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\",\"Failed to load portfolio snapshot\":\"\u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993\u09b0 \u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8 \u099a\u09bf\u09a4\u09cd\u09b0 \u09b2\u09cb\u09a1 \u0995\u09b0\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\",\"Failed to save variables\":\"\u09b8\u09c7\u099f\u09bf\u0982\u09b8 \u09b8\u0982\u09b0\u0995\u09cd\u09b7\u09a3 \u0995\u09b0\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\",\"Fee:\":\"\u09ab\u09bf:\",\"For any portfolio related problem, issue, suggestion or update contact to the whatsapp number: 01XXXXXXXXX.\":\"\u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993 \u09b8\u0982\u0995\u09cd\u09b0\u09be\u09a8\u09cd\u09a4 \u09b8\u09ae\u09b8\u09cd\u09af\u09be, \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6 \u09ac\u09be \u0986\u09aa\u09a1\u09c7\u099f\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u098f\u0987 \u09b9\u09cb\u09af\u09bc\u09be\u099f\u09b8\u0985\u09cd\u09af\u09be\u09aa \u09a8\u09ae\u09cd\u09ac\u09b0\u09c7 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8: 01XXXXXXXXX\u0964\",\"Gain/Loss\":\"\u09b2\u09be\u09ad/\u0995\u09cd\u09b7\u09a4\u09bf\",\"Gain/Loss (%)\":\"\u09b2\u09be\u09ad/\u0995\u09cd\u09b7\u09a4\u09bf (%)\",\"Gain/Loss (Today)\":\"\u09b2\u09be\u09ad/\u0995\u09cd\u09b7\u09a4\u09bf (\u0986\u099c)\",\"Generated By:\":\"\u09aa\u09cd\u09b0\u09b8\u09cd\u09a4\u09c1\u09a4\u0995\u09be\u09b0\u09c0:\",\"Give a Portfolio Name\":\"\u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993\u09b0 \u09a8\u09be\u09ae \u09b2\u09bf\u0996\u09c1\u09a8\",\"HHI (Concentration)\":\"\u098f\u0987\u099a\u098f\u0987\u099a\u0986\u0987 (\u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0\u09c0\u09ad\u09ac\u09a8)\",\"HOLDING VALUE\":\"\u09a7\u09be\u09b0\u09a3\u0995\u09c3\u09a4 \u09b6\u09c7\u09af\u09bc\u09be\u09b0\u09c7\u09b0 \u09ae\u09c2\u09b2\u09cd\u09af\",\"Herfindahl-Hirschman Index (HHI): concentration measure based on position weights. Higher means more concentrated (less diversified).\":\"\u09b9\u09be\u09b0\u09ab\u09bf\u09a8\u09cd\u09a1\u09be\u09b2-\u09b9\u09be\u09b0\u09cd\u09b6\u09ae\u09cd\u09af\u09be\u09a8 \u09b8\u09c2\u099a\u0995 (\u098f\u0987\u099a\u098f\u0987\u099a\u0986\u0987): \u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u09b6\u09c7\u09af\u09bc\u09be\u09b0\u09c7\u09b0 \u09ac\u09bf\u09a8\u09bf\u09af\u09bc\u09cb\u0997\u09c7\u09b0 \u0985\u09a8\u09c1\u09aa\u09be\u09a4\u09c7\u09b0 \u09ad\u09bf\u09a4\u09cd\u09a4\u09bf\u09a4\u09c7 \u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0\u09c0\u09ad\u09ac\u09a8 \u09ae\u09be\u09aa\u09c7\u0964 \u09ae\u09be\u09a8 \u09ac\u09c7\u09b6\u09bf \u09b9\u09b2\u09c7 \u09ac\u09bf\u09a8\u09bf\u09af\u09bc\u09cb\u0997 \u0995\u09ae \u09ac\u09c8\u099a\u09bf\u09a4\u09cd\u09b0\u09cd\u09af\u09aa\u09c2\u09b0\u09cd\u09a3\u0964\",\"History request failed\":\"\u0986\u0997\u09c7\u09b0 \u09a4\u09a5\u09cd\u09af \u0986\u09a8\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\",\"Holding actions\":\"\u09a7\u09be\u09b0\u09a3\u0995\u09c3\u09a4 \u09b6\u09c7\u09af\u09bc\u09be\u09b0\u09c7\u09b0 \u0995\u09b0\u09a3\u09c0\u09af\u09bc\",\"Holdings\":\"\u09a7\u09be\u09b0\u09a3\u0995\u09c3\u09a4 \u09b6\u09c7\u09af\u09bc\u09be\u09b0\",\"If stop hit, portfolio impact: {value}\":\"\u09b8\u09cd\u099f\u09aa \u0995\u09be\u09b0\u09cd\u09af\u0995\u09b0 \u09b9\u09b2\u09c7 \u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993\u09a4\u09c7 \u09aa\u09cd\u09b0\u09ad\u09be\u09ac: {value}\",\"If your stop loss at \u09f3{price} is triggered, your total portfolio value will decrease by approximately {percent} (\u09f3{amount}).\":\"\u09f3{price} \u09a6\u09be\u09ae\u09c7 \u09b8\u09cd\u099f\u09aa \u09b2\u09b8 \u0995\u09be\u09b0\u09cd\u09af\u0995\u09b0 \u09b9\u09b2\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993\u09b0 \u09ae\u09cb\u099f \u09ae\u09c2\u09b2\u09cd\u09af \u0986\u09a8\u09c1\u09ae\u09be\u09a8\u09bf\u0995 {percent} (\u09f3{amount}) \u0995\u09ae\u09ac\u09c7\u0964\",\"Information\":\"\u09a4\u09a5\u09cd\u09af\",\"Input value is greater than sellable value. Max sellable quantity is {value}.\":\"\u09a6\u09c7\u0993\u09af\u09bc\u09be \u09aa\u09b0\u09bf\u09ae\u09be\u09a3 \u09ac\u09bf\u0995\u09cd\u09b0\u09af\u09bc\u09af\u09cb\u0997\u09cd\u09af \u09aa\u09b0\u09bf\u09ae\u09be\u09a3\u09c7\u09b0 \u099a\u09c7\u09af\u09bc\u09c7 \u09ac\u09c7\u09b6\u09bf\u0964 \u09b8\u09b0\u09cd\u09ac\u09cb\u099a\u09cd\u099a {value}\u099f\u09bf \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09ac\u09bf\u0995\u09cd\u09b0\u09bf \u0995\u09b0\u09be \u09af\u09be\u09ac\u09c7\u0964\",\"Instrument\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0\",\"Instrument risk unavailable\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0\u09c7\u09b0 \u099d\u09c1\u0981\u0995\u09bf\u09b0 \u09a4\u09a5\u09cd\u09af \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\",\"Instrument risk: \u2014\":\"\u09b6\u09c7\u09af\u09bc\u09be\u09b0\u09c7\u09b0 \u099d\u09c1\u0981\u0995\u09bf: \u2014\",\"Invested\":\"\u09ac\u09bf\u09a8\u09bf\u09af\u09bc\u09cb\u0997\u0995\u09c3\u09a4\",\"Investment\":\"\u09ac\u09bf\u09a8\u09bf\u09af\u09bc\u09cb\u0997\",\"Item {value}\":\"\u0986\u0987\u099f\u09c7\u09ae {value}\",\"LTP\":\"\u09b8\u09b0\u09cd\u09ac\u09b6\u09c7\u09b7 \u09a6\u09be\u09ae\",\"LTP / Chg\":\"\u09b8\u09b0\u09cd\u09ac\u09b6\u09c7\u09b7 \u09a6\u09be\u09ae / \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8\",\"Largest single position weight (as % of total portfolio stock value). Higher means more single-name concentration.\":\"\u098f\u0995\u099f\u09bf \u09b6\u09c7\u09af\u09bc\u09be\u09b0\u09c7 \u09b8\u09b0\u09cd\u09ac\u09cb\u099a\u09cd\u099a \u09ac\u09bf\u09a8\u09bf\u09af\u09bc\u09cb\u0997\u09c7\u09b0 \u0985\u09a8\u09c1\u09aa\u09be\u09a4 (\u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993\u09b0 \u09ae\u09cb\u099f \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09ae\u09c2\u09b2\u09cd\u09af\u09c7\u09b0 \u09b6\u09a4\u09be\u0982\u09b6)\u0964 \u09ae\u09be\u09a8 \u09ac\u09c7\u09b6\u09bf \u09b9\u09b2\u09c7 \u098f\u0995\u099f\u09bf \u09b6\u09c7\u09af\u09bc\u09be\u09b0\u09c7\u09b0 \u0993\u09aa\u09b0 \u09a8\u09bf\u09b0\u09cd\u09ad\u09b0\u09a4\u09be \u09ac\u09c7\u09b6\u09bf\u0964\",\"Latest Cash\":\"\u09b8\u09b0\u09cd\u09ac\u09b6\u09c7\u09b7 \u09a8\u0997\u09a6\",\"Latest Equity\":\"\u09b8\u09b0\u09cd\u09ac\u09b6\u09c7\u09b7 \u09ae\u09cb\u099f \u09b8\u09ae\u09cd\u09aa\u09a6\",\"Latest Stock\":\"\u09b8\u09b0\u09cd\u09ac\u09b6\u09c7\u09b7 \u09b6\u09c7\u09af\u09bc\u09be\u09b0\u09ae\u09c2\u09b2\u09cd\u09af\",\"Latest cash balance from the series.\":\"\u09b8\u09ae\u09af\u09bc\u0995\u09cd\u09b0\u09ae\u09c7\u09b0 \u09b8\u09b0\u09cd\u09ac\u09b6\u09c7\u09b7 \u09a8\u0997\u09a6 \u09ac\u09cd\u09af\u09be\u09b2\u09c7\u09a8\u09cd\u09b8\u0964\",\"Latest close: {value}\":\"\u09b8\u09b0\u09cd\u09ac\u09b6\u09c7\u09b7 \u0995\u09cd\u09b2\u09cb\u099c\u09bf\u0982 \u09aa\u09cd\u09b0\u09be\u0987\u09b8: {value}\",\"Latest stock market value from the series.\":\"\u09b8\u09ae\u09af\u09bc\u0995\u09cd\u09b0\u09ae\u09c7\u09b0 \u09b8\u09b0\u09cd\u09ac\u09b6\u09c7\u09b7 \u09b6\u09c7\u09af\u09bc\u09be\u09b0\u09c7\u09b0 \u09ac\u09be\u099c\u09be\u09b0\u09ae\u09c2\u09b2\u09cd\u09af\u0964\",\"Latest total equity from the series (cash + stock).\":\"\u09b8\u09ae\u09af\u09bc\u0995\u09cd\u09b0\u09ae\u09c7\u09b0 \u09b8\u09b0\u09cd\u09ac\u09b6\u09c7\u09b7 \u09ae\u09cb\u099f \u09b8\u09ae\u09cd\u09aa\u09a6 (\u09a8\u0997\u09a6 + \u09b6\u09c7\u09af\u09bc\u09be\u09b0)\u0964\",\"Ledger - {value}\":\"\u09b2\u09c7\u099c\u09be\u09b0 - {value}\",\"Lkh\":\" \u09b2\u09be\u0996\",\"Loading recent history\u2026\":\"\u09b8\u09be\u09ae\u09cd\u09aa\u09cd\u09b0\u09a4\u09bf\u0995 \u09a4\u09a5\u09cd\u09af \u09b2\u09cb\u09a1 \u09b9\u099a\u09cd\u099b\u09c7\u2026\",\"Loading...\":\"\u09b2\u09cb\u09a1 \u09b9\u099a\u09cd\u099b\u09c7...\",\"Loss\":\"\u0995\u09cd\u09b7\u09a4\u09bf\",\"MWR %\":\"\u0985\u09b0\u09cd\u09a5\u09ad\u09bf\u09a4\u09cd\u09a4\u09bf\u0995 \u09b0\u09bf\u099f\u09be\u09b0\u09cd\u09a8 %\",\"Market Value\":\"\u09ac\u09be\u099c\u09be\u09b0\u09ae\u09c2\u09b2\u09cd\u09af\",\"Max\":\"\u09b8\u09b0\u09cd\u09ac\u09cb\u099a\u09cd\u099a\",\"Max DD\":\"\u09b8\u09b0\u09cd\u09ac\u09cb\u099a\u09cd\u099a \u09aa\u09a4\u09a8\",\"Max DD: {value}%\":\"\u09b8\u09b0\u09cd\u09ac\u09cb\u099a\u09cd\u099a \u09aa\u09a4\u09a8: {value}%\",\"Max Drawdown\":\"\u09b8\u09b0\u09cd\u09ac\u09cb\u099a\u09cd\u099a \u09aa\u09a4\u09a8\",\"Max Drawdown %\":\"\u09b8\u09b0\u09cd\u09ac\u09cb\u099a\u09cd\u099a \u09aa\u09a4\u09a8 %\",\"Max Weight\":\"\u09b8\u09b0\u09cd\u09ac\u09cb\u099a\u09cd\u099a \u0985\u09a8\u09c1\u09aa\u09be\u09a4\",\"Max drawdown: {value}\":\"\u09b8\u09b0\u09cd\u09ac\u09cb\u099a\u09cd\u099a \u09aa\u09a4\u09a8: {value}\",\"Maximum Drawdown\":\"\u09b8\u09b0\u09cd\u09ac\u09cb\u099a\u09cd\u099a \u09aa\u09a4\u09a8\",\"Maximum drawdown: the largest peak-to-trough decline observed in the series, shown as a percentage.\":\"\u09b8\u09b0\u09cd\u09ac\u09cb\u099a\u09cd\u099a \u09aa\u09a4\u09a8: \u09b8\u09ae\u09af\u09bc\u0995\u09cd\u09b0\u09ae\u09c7 \u09b8\u09b0\u09cd\u09ac\u09cb\u099a\u09cd\u099a \u09ae\u09c2\u09b2\u09cd\u09af \u09a5\u09c7\u0995\u09c7 \u09aa\u09b0\u09ac\u09b0\u09cd\u09a4\u09c0 \u09b8\u09b0\u09cd\u09ac\u09a8\u09bf\u09ae\u09cd\u09a8 \u09ae\u09c2\u09b2\u09cd\u09af \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u09b8\u09ac\u099a\u09c7\u09af\u09bc\u09c7 \u09ac\u09a1\u09bc \u09aa\u09a4\u09a8, \u09b6\u09a4\u09be\u0982\u09b6\u09c7 \u09aa\u09cd\u09b0\u0995\u09be\u09b6\u09bf\u09a4\u0964\",\"Maximum drawdown: the worst peak-to-trough decline in the lookback period. This is shown as a negative % (loss from the peak).\":\"\u09b8\u09b0\u09cd\u09ac\u09cb\u099a\u09cd\u099a \u09aa\u09a4\u09a8: \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09bf\u09a4 \u09b8\u09ae\u09af\u09bc\u09c7 \u09b8\u09b0\u09cd\u09ac\u09cb\u099a\u09cd\u099a \u09ae\u09c2\u09b2\u09cd\u09af \u09a5\u09c7\u0995\u09c7 \u09aa\u09b0\u09ac\u09b0\u09cd\u09a4\u09c0 \u09b8\u09b0\u09cd\u09ac\u09a8\u09bf\u09ae\u09cd\u09a8 \u09ae\u09c2\u09b2\u09cd\u09af \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u09b8\u09ac\u099a\u09c7\u09af\u09bc\u09c7 \u09ac\u09a1\u09bc \u09aa\u09a4\u09a8\u0964 \u098f\u099f\u09bf \u098b\u09a3\u09be\u09a4\u09cd\u09ae\u0995 \u09b6\u09a4\u09be\u0982\u09b6\u09c7 \u09a6\u09c7\u0996\u09be\u09a8\u09cb \u09b9\u09af\u09bc (\u09b8\u09b0\u09cd\u09ac\u09cb\u099a\u09cd\u099a \u09ae\u09c2\u09b2\u09cd\u09af \u09a5\u09c7\u0995\u09c7 \u0995\u09cd\u09b7\u09a4\u09bf)\u0964\",\"Metrics\":\"\u09aa\u09b0\u09bf\u09ae\u09be\u09aa\",\"Metrics ({value})\":\"\u09aa\u09b0\u09bf\u09ae\u09be\u09aa ({value})\",\"Minimum RR: {value}\":\"\u09b8\u09b0\u09cd\u09ac\u09a8\u09bf\u09ae\u09cd\u09a8 \u09b2\u09be\u09ad-\u099d\u09c1\u0981\u0995\u09bf\u09b0 \u0985\u09a8\u09c1\u09aa\u09be\u09a4: {value}\",\"Mkt Price\":\"\u09ac\u09be\u099c\u09be\u09b0\u09a6\u09b0\",\"N/A\":\"\u09aa\u09cd\u09b0\u09af\u09cb\u099c\u09cd\u09af \u09a8\u09af\u09bc\",\"Name A-Z\":\"\u09a8\u09be\u09ae A\u2013Z\",\"Name Z-A\":\"\u09a8\u09be\u09ae Z\u2013A\",\"Net P/L\":\"\u09a8\u09bf\u099f \u09b2\u09be\u09ad/\u0995\u09cd\u09b7\u09a4\u09bf\",\"Newest First\":\"\u09a8\u09a4\u09c1\u09a8\u099f\u09bf \u0986\u0997\u09c7\",\"Next\":\"\u09aa\u09b0\u09ac\u09b0\u09cd\u09a4\u09c0\",\"Next: Add Stocks\":\"\u09aa\u09b0\u09ac\u09b0\u09cd\u09a4\u09c0: \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\",\"No Holdings\":\"\u0995\u09cb\u09a8\u09cb \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09a8\u09c7\u0987\",\"No allocation data available\":\"\u09ac\u09bf\u09a8\u09bf\u09af\u09bc\u09cb\u0997 \u09ac\u09a3\u09cd\u099f\u09a8\u09c7\u09b0 \u09a4\u09a5\u09cd\u09af \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\",\"No best results\":\"\u09b8\u09c7\u09b0\u09be \u09ab\u09b2\u09be\u09ab\u09b2 \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\",\"No best/worst data available\":\"\u09b8\u09c7\u09b0\u09be/\u09b8\u09b0\u09cd\u09ac\u09a8\u09bf\u09ae\u09cd\u09a8 \u09ab\u09b2\u09be\u09ab\u09b2\u09c7\u09b0 \u09a4\u09a5\u09cd\u09af \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\",\"No holdings found.\":\"\u09a7\u09be\u09b0\u09a3\u0995\u09c3\u09a4 \u0995\u09cb\u09a8\u09cb \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\u0964\",\"No metrics available\":\"\u0995\u09cb\u09a8\u09cb \u09aa\u09b0\u09bf\u09ae\u09be\u09aa \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\",\"No portfolio yet\":\"\u098f\u0996\u09a8\u09cb \u0995\u09cb\u09a8\u09cb \u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993 \u09a8\u09c7\u0987\",\"No profit distribution data available\":\"\u09b2\u09be\u09ad \u09ac\u09a3\u09cd\u099f\u09a8\u09c7\u09b0 \u09a4\u09a5\u09cd\u09af \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\",\"No snapshot data available\":\"\u09a8\u09bf\u09b0\u09cd\u09a6\u09bf\u09b7\u09cd\u099f \u09b8\u09ae\u09af\u09bc\u09c7\u09b0 \u099a\u09bf\u09a4\u09cd\u09b0 \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\",\"No transactions for selected action.\":\"\u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09bf\u09a4 \u09a7\u09b0\u09a8\u09c7\u09b0 \u0995\u09cb\u09a8\u09cb \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 \u09a8\u09c7\u0987\u0964\",\"No transactions found for this portfolio.\":\"\u098f\u0987 \u09aa\u09cb\u09b0\u09cd\u099f\u09ab\u09cb\u09b2\u09bf\u0993\u09a4\u09c7 \u0995\u09cb\u09a8\u09cb \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\u0964\",\"No usable history\":\"\u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u09af\u09cb\u0997\u09cd\u09af \u0986\u0997\u09c7\u09b0 \u09a4\u09a5\u09cd\u09af \u09a8\u09c7\u0987\",\"No worst results\":\"\u09b8\u09b0\u09cd\u09ac\u09a8\u09bf\u09ae\u09cd\u09a8 \u09ab\u09b2\u09be\u09ab\u09b2 \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\",\"None\":\"\u0995\u09cb\u09a8\u09cb\u099f\u09bf\u0987 \u09a8\u09af\u09bc\",\"Number of datapoints (snapshots/observations) used in the calculations. More points generally means more stable estimates.\":\"\u09b9\u09bf\u09b8\u09be\u09ac\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09ac\u09cd\u09af\u09ac\u09b9\u09c3\u09a4 \u09a4\u09a5\u09cd\u09af\u09c7\u09b0 \u09b8\u0982\u0996\u09cd\u09af\u09be\u0964 \u09a4\u09a5\u09cd\u09af \u09ac\u09c7\u09b6\u09bf \u09b9\u09b2\u09c7 \u09b8\u09be\u09a7\u09be\u09b0\u09a3\u09a4 \u0985\u09a8\u09c1\u09ae\u09be\u09a8 \u0986\u09b0\u0993 \u09b8\u09cd\u09a5\u09bf\u09a4\u09bf\u09b6\u09c0\u09b2 \u09b9\u09af\u09bc\u0964\",\"Number of instruments included in the correlation matrix. Correlation is computed from historical return series.\":\"\u09b8\u09b9\u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7\u09b0 \u09b8\u09be\u09b0\u09a3\u09bf\u09a4\u09c7 \u0985\u09a8\u09cd\u09a4\u09b0\u09cd\u09ad\u09c1\u0995\u09cd\u09a4 \u09b6\u09c7\u09af\u09bc\u09be\u09b0\u09c7\u09b0 \u09b8\u0982\u0996\u09cd\u09af\u09be\u0964 \u0986\u0997\u09c7\u09b0 \u09b0\u09bf\u099f\u09be\u09b0\u09cd\u09a8\u09c7\u09b0 \u09b8\u09ae\u09af\u09bc\u0995\u09cd\u09b0\u09ae \u09a5\u09c7\u0995\u09c7 \u09b8\u09b9\u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995 \u09b9\u09bf\u09b8\u09be\u09ac \u0995\u09b0\u09be \u09b9\u09af\u09bc\u0964\",\"OK\":\"\u09a0\u09bf\u0995 \u0986\u099b\u09c7\",\"Oldest First\":\"\u09aa\u09c1\u09b0\u09cb\u09a8\u09cb\u099f\u09bf \u0986\u0997\u09c7\",\"Operation Failed: {value}\":\"\u0995\u09be\u099c\u099f\u09bf \u09b8\u09ae\u09cd\u09aa\u09a8\u09cd\u09a8 \u09b9\u09af\u09bc\u09a8\u09bf: {value}\",\"Overall Return\":\"\u09b8\u09be\u09ae\u0997\u09cd\u09b0\u09bf\u0995 \u09b0\u09bf\u099f\u09be\u09b0\u09cd\u09a8\",\"P/L\":\"\u09b2\u09be\u09ad/\u0995\u09cd\u09b7\u09a4\u09bf\",\"P/L: {value}\":\"\u09b2\u09be\u09ad/\u0995\u09cd\u09b7\u09a4\u09bf: {value}\",\"PLANNED ENTRY\":\"\u09aa\u09b0\u09bf\u0995\u09b2\u09cd\u09aa\u09bf\u09a4 \u09aa\u09cd\u09b0\u09ac\u09c7\u09b6\u09ae\u09c2\u09b2\u09cd\u09af\",\"PLANNED R:R\":\"\u09aa\u09b0\u09bf\u0995\u09b2\u09cd\u09aa\u09bf\u09a4 \u09b2\u09be\u09ad-\u099d\u09c1\u0981\u0995\u09bf\u09b0 \u0985\u09a8\u09c1\u09aa\u09be\u09a4\",\"PLANNED STOP\":\"\u09aa\u09b0\u09bf\u0995\u09b2\u09cd\u09aa\u09bf\u09a4 \u09b8\u09cd\u099f\u09aa\",\"PLANNED TARGET\":\"\u09aa\u09b0\u09bf\u0995\u09b2\u09cd\u09aa\u09bf\u09a4 \u09b2\u0995\u09cd\u09b7\u09cd\u09af\",\"POSITION SIZE\":\"\u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8\u09c7\u09b0 \u0986\u0995\u09be\u09b0\",\"PRICE PER SHARE\":\"\u09aa\u09cd\u09b0\u09a4\u09bf \u09b6\u09c7\u09af\u09bc\u09be\u09b0\u09c7\u09b0 \u09a6\u09be\u09ae\",\"Performance\":\"\u09ac\u09bf\u09a8\u0