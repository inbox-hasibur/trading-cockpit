l,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"}, {"name": "Cookie", "value": "***REDACTED***"}, {"name": "Upgrade-Insecure-Requests", "value": "1"}, {"name": "User-Agent", "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/156.0.8078.4 Safari/537.36"}, {"name": "sec-ch-ua", "value": "\"Not:A-Brand\";v=\"8\", \"Chromium\";v=\"156\", \"HeadlessChrome\";v=\"156\""}, {"name": "sec-ch-ua-mobile", "value": "?0"}, {"name": "sec-ch-ua-platform", "value": "\"Windows\""}], "queryString": [], "headersSize": -1, "bodySize": -1}, "response": {"status": 200, "statusText": "OK", "httpVersion": "HTTP/1.1", "cookies": [], "headers": [{"name": "Cache-Control", "value": "max-age=1800"}, {"name": "Cache-Control", "value": "public, no-transform"}, {"name": "Connection", "value": "keep-alive"}, {"name": "Content-Encoding", "value": "gzip"}, {"name": "Content-Type", "value": "text/html"}, {"name": "Date", "value": "Sat, 07 Nov 2026 19:08:18 GMT"}, {"name": "ETag", "value": "W/\"6ae81001-109b\""}, {"name": "Expires", "value": "Sat, 07 Nov 2026 19:38:18 GMT"}, {"name": "Last-Modified", "value": "Mon, 02 Nov 2026 04:22:25 GMT"}, {"name": "Pragma", "value": "public"}, {"name": "Server", "value": "nginx/1.22.0"}, {"name": "Transfer-Encoding", "value": "chunked"}], "content": {"size": -1, "mimeType": "text/html", "text": "<!doctype html><html lang=\"en\" mode=\"ios\"><head><meta charset=\"utf-8\"><meta name=\"apple-mobile-web-app-capable\" content=\"yes\"><meta name=\"description\" content=\"Explore the dynamic realm of stock investment and trading with StockNow, featuring powerful Dhaka Stock Exchange (DSE) and Chittagong Stock Exchange (CSE) fundamental and technical analysis tools tailored for Bangladesh. Our platform is your gateway to comprehensive stock analysis, market trends, and live charts. Whether you're a seasoned investor or a beginner, StockNow provides valuable insights into buying stocks, trading shares, and navigating the complexities of the stock market. Stay informed with the latest market news, share prices, and real-time data. Research the Dhaka Stock Exchange like a professional with our best-in-class tools. Join us on a journey of informed investment, where stocks and shares meet expert analysis, and the market is demystified for beginners. Invest confidently with StockNow - your trusted partner in smart stock marketing and profitable stock trading.\"><meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\"><meta name=\"color-scheme\" content=\"light dark\"/><meta name=\"viewport\" content=\"user-scalable=no,initial-scale=1,maximum-scale=1,minimum-scale=1,width=device-width,viewport-fit=cover\"><link rel=\"icon\" href=\"/favicon.ico\"><title>Bangladesh DSE Share Price Today \u2014 Live Market Data & Stock Analysis | StockNow</title><script type=\"application/ld+json\">{\n    \"@context\": \"http://schema.org\",\n    \"@type\": \"Organization\",\n    \"name\": \"StockNow\",\n    \"description\": \"StockNow is Bangladesh's premier and highly acclaimed stock analysis portal. Unveiling a contemporary approach to financial insight, StockNow stands out as the go-to destination for investors, offering a rich array of cutting-edge analysis tools seamlessly integrated into an intuitive and user-friendly interface. Empowering individuals with the tools they need to make informed investment decisions, StockNow redefines the landscape of stock analysis in Bangladesh. Explore the limitless possibilities of financial analysis at your fingertips, and embark on a journey of unparalleled market understanding with StockNow, where innovation meets simplicity.\",\n    \"url\": \"https://stocknow.com.bd\",\n    \"logo\": \"https://stocknow.com.bd/logo.webp\",\n    \"founder\": {\n      \"@type\": \"Person\",\n      \"name\": \"Selim Aminul\"\n    },    \n    \"sameAs\": [\n      \"https://www.linkedin.com/company/team-stocknow\",\n      \"https://www.facebook.co