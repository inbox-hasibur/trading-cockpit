# Copy to backend/.env. Never commit keys, the ledger, or browser cookies.
# Sprint 1 intentionally rejects every trading mode except DEMO.
TRADING_MODE=DEMO

# Leave blank to use backend/data/hummingbird.db. Prefer an absolute path outside
# OneDrive for sustained use, e.g. sqlite:///C:/humming-bird-data/hummingbird.db
DATABASE_URL=
INITIAL_CAPITAL=15000
DEMO_START_DATE=

BUY_FEE_RATE=0.005
SELL_FEE_RATE=0.005
SETTLEMENT_DAYS=2
MIN_BUY_NOTIONAL=100
# Unverified DEMO calendar/hours. These must not authorize live execution.
DSE_HOLIDAYS=
MARKET_OPEN=10:00
MARKET_CLOSE=14:30

# Optional external read-only chat. Blank key = free, local summaries only.
OPENROUTER_API_KEY=
# Requested model; absent from the catalog checked 2026-11-03. If unavailable,
# explicitly choose an available model, e.g. deepseek/deepseek-chat.
OPENROUTER_MODEL=xiaomi/mimo-v2-flash
CHAT_DAILY_CALL_LIMIT=30
CHAT_MAX_OUTPUT_TOKENS=500

# Future Sprint 3 integration: not used or contacted in Sprint 1.
TELEGRAM_BOT_TOKEN=

# Optional Bearer token (at least 16 characters). Required for non-loopback hosts.
COCKPIT_API_TOKEN=
TRUSTED_HOSTS=localhost,127.0.0.1
