# Copy to backend/.env. Never commit real keys, the database, or browser cookies.
# Sprint 1 & 2 operate in DEMO mode with local SQLite ledger reconciliation.
TRADING_MODE=DEMO

# Leave blank to use backend/data/hummingbird.db.
# Prefer an absolute path outside OneDrive for sustained use, e.g. sqlite:///C:/humming-bird-data/hummingbird.db
DATABASE_URL=
INITIAL_CAPITAL=15000
DEMO_START_DATE=

BUY_FEE_RATE=0.005
SELL_FEE_RATE=0.005
SETTLEMENT_DAYS=2
MIN_BUY_NOTIONAL=100

# DSE calendar & market hours (Asia/Dhaka)
DSE_HOLIDAYS=
MARKET_OPEN=10:00
MARKET_CLOSE=14:30

# ==============================================================================
# Hermes 3-Tier AI Brain Settings
# ==============================================================================
# Tier 1 Brain: OpenRouter API key & model
# Leave blank to fallback to Tier 2 (Gemini) or Tier 3 (Deterministic Quant Brain)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=xiaomi/mimo-v2-flash

# Tier 2 Brain: Google Gemini API Key (gemini-2.5-flash / gemini-2.0-flash fallback)
GEMINI_API_KEY=

# Chat Guardrails
CHAT_DAILY_CALL_LIMIT=30
CHAT_MAX_OUTPUT_TOKENS=500

# ==============================================================================
# StockNow Bridge & Operator Credentials
# ==============================================================================
# Used by persistent Playwright CDP session for auto-login to stocknow.com.bd
OPERATOR_USERNAME=01882082502
OPERATOR_PASSWORD=Stocknow#909109
OPERATOR_NAME=Hasibur Rahman
OPERATOR_PORTFOLIO=Humming Bird (StockNow)

# ==============================================================================
# Telegram Bot Alerts & Push Notifications (Sprint 3)
# ==============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==============================================================================
# Security & Host Authorization
# ==============================================================================
# Optional Bearer token (at least 16 characters). Required for non-loopback hosts.
COCKPIT_API_TOKEN=
TRUSTED_HOSTS=localhost,127.0.0.1
